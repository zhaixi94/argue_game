{
  "chapter": "第1期·新手教学",
  "month": 10,
  "title": "灭门",
  "quest": "quest_m10",
  "scenes": [
    {
      "id": "m10_night_calm",
      "background": "bg_shenjia_bedroom_night",
      "bgm": { "track": "bgm_shenjia_night", "action": "play", "fade": 3 },
      "characters": ["陆子衡", "沈婉清"],
      "script": [
          { "type": "bg_change", "background": "bg_shenjia_bedroom_night", "transition": "fade" },
          { "type": "narration", "text": "十月初九。白天下了一天的雨，入夜才停。檐下还在滴水，一滴一滴打在廊下的石板上。" },
          { "type": "effect", "action": "show", "target": "陆子衡", "pos": "right", "expr": "cheerful" },
          { "type": "action", "actor": "陆子衡", "emotion": "cheerful", "text": "陆子衡躺在床上，把被子蹬了一半到你身上——" },
          { "type": "dialog", "speaker": "陆子衡", "emotion": "cheerful", "text": "你们家的被子怎么这么厚，闷死了。" },
          { "type": "dialog", "speaker": "主角", "emotion": "neutral", "text": "你蹬过来我盖什么。" },
          { "type": "dialog", "speaker": "陆子衡", "emotion": "cheerful", "text": "你那边还有一床呢。" },
          { "type": "action", "actor": "主角", "emotion": "neutral", "text": "你把被子扯回来一半。他又蹬。你踹了他一脚——" },
          { "type": "dialog", "speaker": "陆子衡", "emotion": "cheerful", "text": "哎——你踹我干嘛。" },
          { "type": "dialog", "speaker": "主角", "emotion": "neutral", "text": "再蹬你就回你自己家睡。" },
          { "type": "dialog", "speaker": "陆子衡", "emotion": "cheerful", "text": "下着雨呢。路又远。不回了。" },
          { "type": "action", "actor": "陆子衡", "emotion": "cheerful", "text": "他翻了个身，安静了一会儿。又开口——" },
          { "type": "dialog", "speaker": "陆子衡", "emotion": "cheerful", "text": "你说那只燕子飞了没？" },
          { "type": "dialog", "speaker": "主角", "emotion": "neutral", "text": "上个月就飞了。" },
          { "type": "dialog", "speaker": "陆子衡", "emotion": "cheerful", "text": "我知道飞了。我是说——它今年还会回来吗？" },
          { "type": "dialog", "speaker": "主角", "emotion": "neutral", "text": "你不是说了，它本来就是天上的。" },
          { "type": "dialog", "speaker": "陆子衡", "emotion": "neutral", "text": "嗯……" },
          { "type": "action", "actor": "陆子衡", "emotion": "neutral", "text": "他没再说话。过了一会儿呼吸匀了，睡着了。" },
          { "type": "effect", "action": "hide", "target": "陆子衡" },
          { "type": "wait", "seconds": 0.5 },
          {
              "type": "branch",
              "condition": "protagonist_gender",
              "male": [
                  { "type": "action", "actor": "主角", "emotion": "neutral", "text": "你从枕头底下把那盏花灯掏出来，借着窗外月光看了看。灯架底部的「沈」字还在，刻痕比七月那会儿深了点——苏若兰拿簪子刻的，你摸过太多次，边都磨圆了。纸糊的灯面皱了，有一角塌了，你拿手指撑了撑，又塌了。" },
                  { "type": "thought", "text": "她说别弄丢了。" },
                  { "type": "action", "actor": "主角", "emotion": "neutral", "text": "你看了一会儿，塞回枕头底下。灯架硌着后脑勺，翻了个身才不硌。" }
              ],
              "female": [
                  { "type": "action", "actor": "主角", "emotion": "neutral", "text": "你从枕头底下把那把竹骨折扇抽出来，展开看了一眼。扇面上的诗墨色深浅不一，有几处洇了——在船上颠着写的。竹节上那个像泪滴的斑点还在。你用指腹摸了摸那道竹纹，凉丝丝的。" },
                  { "type": "thought", "text": "他说留着吧。" },
                  { "type": "action", "actor": "主角", "emotion": "neutral", "text": "你看了一会儿，合上塞回枕头底下。扇柄硌着后脑勺，翻了个身才不硌。" }
              ]
          },
          { "type": "wait", "seconds": 1 },
          { "type": "effect", "action": "show", "target": "沈婉清", "pos": "left", "expr": "gentle" },
          { "type": "action", "actor": "沈婉清", "emotion": "gentle", "text": "门被推开一条缝。长姐站在门口，探进半个身子——" },
          { "type": "dialog", "speaker": "沈婉清", "emotion": "gentle", "text": "睡了没？" },
          { "type": "dialog", "speaker": "主角", "emotion": "neutral", "text": "快了。" },
          { "type": "action", "actor": "沈婉清", "emotion": "gentle", "text": "她走进来，轻手轻脚的。看见你枕头边上露出花灯的一角，弯腰替你往里塞了塞——" },
          { "type": "dialog", "speaker": "沈婉清", "emotion": "gentle", "text": "这东西还搁枕边呢。也不怕压坏了。" },
          { "type": "dialog", "speaker": "主角", "emotion": "neutral", "text": "压不坏。" },
          { "type": "action", "actor": "沈婉清", "emotion": "gentle", "text": "她没再说。弯腰把陆子衡蹬开的被子拉回来盖好——他嘟囔了一声，翻了个身，又睡过去了。给你也掖了掖被角，手指在你肩头按了按。" },
          { "type": "dialog", "speaker": "沈婉清", "emotion": "gentle", "text": "睡吧。" },
          { "type": "dialog", "speaker": "主角", "emotion": "neutral", "text": "嗯。姐，你也早点睡。" },
          { "type": "action", "actor": "沈婉清", "emotion": "gentle", "text": "长姐走到门口，回头看了一眼。月光从窗棂照进来，照着两张并着的枕头——陆子衡的脑袋歪到你这边来了，挤了你半边枕。" },
          { "type": "action", "actor": "沈婉清", "emotion": "gentle", "text": "她轻轻笑了一下。站了一会儿，没走。" },
          { "type": "dialog", "speaker": "沈婉清", "emotion": "gentle", "text": "你看他。每次来都抢你的枕头。" },
          { "type": "dialog", "speaker": "主角", "emotion": "neutral", "text": "……嗯。" },
          { "type": "action", "actor": "沈婉清", "emotion": "gentle", "text": "她把门轻轻带上。带门之前又看了一眼——这回看的不是陆子衡，是你。" },
          { "type": "effect", "action": "hide", "target": "沈婉清" },
          { "type": "wait", "seconds": 1 }
      ]
    },
    {
      "id": "m10_night_attack",
      "background": "bg_shenjia_courtyard_night",
      "bgm": { "track": "bgm_shenjia_tension", "action": "play", "fade": 1 },
      "characters": ["陆子衡", "柳蕙心", "沈伯宁", "老仆"],
      "script": [
          { "type": "bg_change", "background": "bg_shenjia_courtyard_night", "transition": "fade" },
          { "type": "narration", "text": "深夜。一阵声响把你惊醒——不是敲门声，是砸门声。有人在用力拍沈家正门，一下一下，越拍越急。" },
          { "type": "action", "actor": "主角", "emotion": "scared", "text": "你翻身坐起来。心跳得很快。" },
          { "type": "effect", "action": "show", "target": "陆子衡", "pos": "right", "expr": "scared" },
          { "type": "action", "actor": "陆子衡", "emotion": "scared", "text": "陆子衡也醒了，揉着眼睛坐起来——" },
          { "type": "dialog", "speaker": "陆子衡", "emotion": "scared", "text": "怎么了？谁啊？" },
          { "type": "dialog", "speaker": "主角", "emotion": "scared", "text": "别说话。" },
          { "type": "narration", "text": "隔壁屋传来父亲的脚步声，很快。母亲的声音压得很低，拦住了他——" },
          { "type": "dialog", "speaker": "柳蕙心", "emotion": "stern", "text": "先别出去。" },
          { "type": "wait", "seconds": 0.5 },
          { "type": "effect", "action": "show", "target": "老仆", "pos": "left", "expr": "stern" },
          { "type": "action", "actor": "老仆", "emotion": "stern", "text": "门被推开。老仆摸黑跑进来，蹲到床边，低声说——" },
          { "type": "dialog", "speaker": "老仆", "emotion": "stern", "text": "少爷别怕，我在。" },
          { "type": "action", "actor": "老仆", "emotion": "stern", "text": "他一手一个把你和陆子衡从床上拽起来。你赤脚踩在地上，石板冰凉。他把你们推到廊柱后面，按着肩膀蹲低——" },
          { "type": "dialog", "speaker": "老仆", "emotion": "stern", "text": "别动。不管听见什么都别动。" },
          { "type": "dialog", "speaker": "陆子衡", "emotion": "scared", "text": "到底怎么了——" },
          { "type": "dialog", "speaker": "老仆", "emotion": "stern", "text": "别出声。" },
          { "type": "effect", "action": "hide", "target": "陆子衡" },
          { "type": "wait", "seconds": 1 },
          { "type": "narration", "text": "砸门声停了。院里安静了一瞬。然后门开了——从里面开的。" },
          { "type": "action", "actor": "老仆", "emotion": "stern", "text": "老仆按着你们的肩膀，从廊柱后面看出去。月光照着院子，很亮。" },
          { "type": "effect", "action": "show", "target": "沈伯宁", "pos": "center", "expr": "scared" },
          { "type": "action", "actor": "沈伯宁", "emotion": "scared", "text": "二叔站在正门口。他穿着白日的衣裳，没换。身后站着十几个黑衣人，蒙着面，手里拿着刀。" },
          { "type": "thought", "text": "二叔？" },
          { "type": "wait", "seconds": 0.5 },
          { "type": "action", "actor": "沈伯宁", "emotion": "scared", "text": "黑衣头领站在门口低声吩咐了几句，一挥手。黑衣人分成四路，往院子里散开。一路往正院，一路往偏院，一路往西院，一路往内院——你们这边。" },
          { "type": "action", "actor": "老仆", "emotion": "stern", "text": "老仆的手按紧了你的肩膀。你感觉他的手也在抖。" },
          { "type": "wait", "seconds": 0.5 },
          { "type": "action", "actor": "沈伯宁", "emotion": "scared", "vfx": "shake", "text": "二叔的手在发抖。他低着头，不敢看院子里的人。黑衣头领从他身边走过去，回头看了他一眼。" },
          { "type": "dialog", "speaker": "沈伯宁", "emotion": "cry", "text": "……我做了。你们答应过——不伤孩子。" },
          { "type": "thought", "text": "他做了什么？" },
          { "type": "action", "actor": "沈伯宁", "emotion": "scared", "text": "黑衣头领没理他。二叔被推到一边，靠在门框上，腿软了，顺着门框滑下去蹲在地上。他的手还举着，举在半空，没人接。" },
          { "type": "effect", "action": "hide", "target": "沈伯宁" },
          { "type": "thought", "text": "脑子里嗡了一声。" },
          { "type": "wait", "seconds": 1 },
          { "type": "narration", "text": "院子里开始有喊声、打斗声、哭声。不是从一处传来——是四面八方。整个沈家，每一处院子都在响。" },
          { "type": "narration", "text": "老叔公那边传来一声闷响，然后安静了。接着是祖母的哭声，很短，也安静了。" },
          { "type": "thought", "text": "老叔公……祖母……" },
          { "type": "narration", "text": "西院那边有人在喊「救命」，喊了几声，也安静了。" },
          { "type": "action", "actor": "老仆", "emotion": "stern", "text": "老仆的手死死按着你的肩。按得你肩头发疼。" },
          { "type": "thought", "text": "一院子一院子地安静下去。像灯一盏一盏地灭。" },
          { "type": "wait", "seconds": 1 }
      ]
    },
    {
      "id": "m10_defense_escape",
      "background": "bg_shenjia_courtyard_night",
      "bgm": { "track": "bgm_shenjia_tension", "action": "play", "fade": 0 },
      "characters": ["沈伯远", "柳蕙心", "沈婉清", "陆子衡", "老仆"],
      "script": [
          { "type": "effect", "action": "show", "target": "沈伯远", "pos": "center", "expr": "stern" },
          { "type": "action", "actor": "沈伯远", "emotion": "stern", "text": "父亲从卧房出来了。他手里拿着一柄剑——挂在书房墙上的那柄，平时从来不摘的。他没穿外衫，赤脚踩在石板上，挡在通往内院的廊道口。" },
          { "type": "action", "actor": "沈伯远", "emotion": "stern", "text": "黑衣人涌上来。父亲一剑挡开了第一个——刀刃撞在剑身上，火星一闪。又挡开了第二个。他不是武人，剑法生疏，但廊道口只有一人宽，一时冲不破。" },
          { "type": "thought", "text": "爹从来不动那柄剑。" },
          { "type": "wait", "seconds": 0.5 },
          { "type": "narration", "text": "前院传来母亲的声音——很大，像是故意喊的。" },
          { "type": "dialog", "speaker": "柳蕙心", "emotion": "stern", "text": "人在正堂！都过来！" },
          { "type": "narration", "text": "杂乱的脚步声从前院涌向正堂。原本要往内院冲的几个人折了回去。" },
          { "type": "thought", "text": "她把追兵往自己身上引。" },
          { "type": "action", "actor": "沈伯远", "emotion": "stern", "text": "父亲趁这个空挡回头看了一眼廊柱——看见你和陆子衡躲在后面，老仆守在两人身前。他没说话，朝长姐的屋方向喊了一声——" },
          { "type": "dialog", "speaker": "沈伯远", "emotion": "stern", "text": "婉清！" },
          { "type": "action", "actor": "沈伯远", "emotion": "stern", "text": "他转回头，剑横在廊道口，又挡住了一个冲上来的黑衣人。肩上挨了一刀，血顺着手臂流下来，剑握得更紧了。" },
          { "type": "effect", "action": "hide", "target": "沈伯远" },
          { "type": "wait", "seconds": 0.5 },
          { "type": "effect", "action": "show", "target": "沈婉清", "pos": "center", "expr": "stern" },
          { "type": "action", "actor": "沈婉清", "emotion": "stern", "text": "长姐从内院跑出来了。她穿着寝衣，头发散着，脸白得没有血色。她一手拉住你，一手拉住陆子衡——手心全是汗，攥得你生疼。" },
          { "type": "dialog", "speaker": "沈婉清", "emotion": "stern", "text": "跑！" },
          { "type": "effect", "action": "show", "target": "陆子衡", "pos": "right", "expr": "scared" },
          { "type": "effect", "action": "show", "target": "老仆", "pos": "left", "expr": "stern" },
          { "type": "action", "actor": "老仆", "emotion": "stern", "text": "老仆护在你们外侧，四个人往祠堂方向跑。" },
          { "type": "action", "actor": "陆子衡", "emotion": "scared", "text": "陆子衡光着脚，跑得踉踉跄跄，手被长姐拽着，另一只手死死抓着自己的袖子——" },
          { "type": "dialog", "speaker": "陆子衡", "emotion": "scared", "text": "怎么回事——那些人是谁——" },
          { "type": "dialog", "speaker": "沈婉清", "emotion": "stern", "text": "别说话。跑。" },
          { "type": "wait", "seconds": 0.5 },
          { "type": "narration", "text": "刚拐过廊道，一队黑衣人从侧面包抄过来，截断了去路。" },
          { "type": "action", "actor": "老仆", "emotion": "stern", "text": "老仆挡在前头迎上去——被一刀砍在肩上，踉跄着没倒。他回过头，冲长姐喊了一声——" },
          { "type": "dialog", "speaker": "老仆", "emotion": "stern", "text": "带他们走！" },
          { "type": "action", "actor": "沈婉清", "emotion": "stern", "text": "长姐拽着你们猛地往回缩。人群涌上来，你被挤得踉跄了一下，手滑了——" },
          { "type": "action", "actor": "主角", "emotion": "scared", "text": "你伸手去抓，抓了个空。陆子衡被隔在人群另一侧了。" },
          { "type": "dialog", "speaker": "主角", "emotion": "scared", "text": "子衡！" },
          { "type": "narration", "text": "黑衣人挡在中间。你看见陆子衡的脸从人缝里闪了一下——他张着嘴在喊什么，听不见。" },
          { "type": "wait", "seconds": 0.5 },
          { "type": "action", "actor": "老仆", "emotion": "stern", "text": "老仆从人群缝里挤过去，一把抱起陆子衡就往后门方向跑——肩上还在流血，血顺着手臂滴在地上，但抱着孩子没停。" },
          { "type": "action", "actor": "主角", "emotion": "scared", "text": "你看见陆子衡的腿在半空中蹬了两下。然后被拐过墙角，看不见了。" },
          { "type": "effect", "action": "hide", "target": "陆子衡" },
          { "type": "effect", "action": "hide", "target": "老仆" },
          { "type": "thought", "text": "子衡……" },
          { "type": "wait", "seconds": 0.5 },
          { "type": "action", "actor": "沈婉清", "emotion": "stern", "text": "长姐重新攥住你的手腕，死死拽着。她的手心全是汗和血——你不知道是她的血还是别人的。她没看后头，只往前跑。" },
          { "type": "dialog", "speaker": "主角", "emotion": "scared", "text": "子衡他——" },
          { "type": "dialog", "speaker": "沈婉清", "emotion": "stern", "text": "老仆会带他走。别回头。" },
          { "type": "action", "actor": "主角", "emotion": "scared", "text": "你跑着。她手臂上不知什么时候被划了一道，血顺着手腕流下来，黏在你手背上。热的。" },
          { "type": "effect", "action": "hide", "target": "沈婉清" },
          { "type": "wait", "seconds": 0.5 }
      ]
    },
    {
      "id": "m10_ancestral_hall_tunnel",
      "background": "bg_shenjia_ancestral_hall",
      "bgm": { "track": "bgm_shenjia_tension", "action": "play", "fade": 0 },
      "characters": ["沈婉清"],
      "script": [
          { "type": "bg_change", "background": "bg_shenjia_ancestral_hall", "transition": "fade" },
          { "type": "effect", "action": "show", "target": "沈婉清", "pos": "center", "expr": "stern" },
          { "type": "action", "actor": "沈婉清", "emotion": "stern", "text": "跑进祠堂。檀香味还在，供桌上的三炷香烧得只剩一截。长姐直奔最里头墙根——供桌后面的旧木箱搬开了，石门就在那里，半开着。" },
          { "type": "thought", "text": "三月那天爹推过的那扇门。" },
          { "type": "wait", "seconds": 0.5 },
          { "type": "action", "actor": "沈婉清", "emotion": "stern", "text": "长姐双手按在石门上往里推。石门极沉，石槽里发出低沉的磨响，像石轴在转。她推了好几下，咬着牙，才打开一个能过人的缝。" },
          { "type": "narration", "text": "暗阶往下斜，黑漆漆的，一股潮湿的霉味扑上来。" },
          { "type": "action", "actor": "沈婉清", "emotion": "stern", "text": "她把你往里推——" },
          { "type": "action", "actor": "主角", "emotion": "scared", "text": "你抓住了她的手。她的手在抖——不是冷，是别的什么。" },
          { "type": "dialog", "speaker": "主角", "emotion": "scared", "text": "姐，你一起走——" },
          { "type": "dialog", "speaker": "沈婉清", "emotion": "stern", "text": "别回头。跑。" },
          { "type": "dialog", "speaker": "主角", "emotion": "scared", "text": "你跟我一起——" },
          { "type": "action", "actor": "沈婉清", "emotion": "stern", "text": "她用力掰开你的手指。一根一根掰的。你抓着她的袖子，她把袖子从你手里扯出去——" },
          { "type": "dialog", "speaker": "沈婉清", "emotion": "stern", "text": "跑。听见没有。" },
          { "type": "action", "actor": "沈婉清", "emotion": "stern", "text": "她把你推进暗阶。你踉跄了两步，撞在石壁上，肩膀磕得生疼。" },
          { "type": "wait", "seconds": 0.5 },
          { "type": "action", "actor": "沈婉清", "emotion": "stern", "text": "长姐转身去推石门——石门太沉，合得很慢，石槽里的磨响在夜里格外刺耳。推了一半，追兵的脚步声已经到祠堂门口了。" },
          { "type": "thought", "text": "她在推门。推不上。" },
          { "type": "wait", "seconds": 0.5 },
          { "type": "action", "actor": "沈婉清", "emotion": "stern", "text": "长姐停了。她没有继续推门。她转身——挡在半开的石门前。" },
          { "type": "thought", "text": "她不是推不上。她是不推了。" },
          { "type": "action", "actor": "主角", "emotion": "scared", "text": "你在暗阶上往下走了两步，回头看——" },
          { "type": "narration", "text": "石门半合着，门缝里透进一线月光。长姐站在那条光里，背对着你，面朝祠堂门口。她的背影很瘦，头发散着，寝衣上沾着血。" },
          { "type": "narration", "text": "然后火光涌进来，脚步声涌进来。" },
          { "type": "wait", "seconds": 0.5 },
          { "type": "dialog", "speaker": "主角", "emotion": "scared", "text": "姐——！" },
          { "type": "narration", "text": "石门被人从外面撞上了——闷响一声。不知道是长姐推上的还是追兵推上的。你的喊声被石壁挡住了，闷在暗阶里。" },
          { "type": "narration", "text": "然后是刀刃劈进肉里的声音。没有喊叫。一声都没有。" },
          { "type": "effect", "action": "hide", "target": "沈婉清" },
          { "type": "thought", "text": "……" },
          { "type": "wait", "seconds": 2 }
      ]
    },
    {
      "id": "m10_tunnel_silence",
      "background": "bg_tunnel_dark",
      "bgm": { "track": "bgm_tunnel_drone", "action": "play", "fade": 2 },
      "characters": [],
      "script": [
          { "type": "bg_change", "background": "bg_tunnel_dark", "transition": "fade" },
          { "type": "narration", "text": "密道里很黑。什么都看不见。你伸出手摸着石壁，石壁上全是水，湿冷的，指尖碰上去沾了一层滑腻的苔。" },
          { "type": "action", "actor": "主角", "emotion": "neutral", "text": "你往前走。脚下的路往下斜，越走越深。鞋底踩在石阶上，每一步都发出回响，嗡嗡的，分不清是自己的脚步还是别的什么。" },
          { "type": "wait", "seconds": 1 },
          { "type": "narration", "text": "头顶偶尔传来闷响——隔着石壁，像远处在打雷。" },
          { "type": "wait", "seconds": 1 },
          { "type": "narration", "text": "走了一段，上面又传来声响。不是闷响了——是打斗声，很近，就在头顶。" },
          { "type": "narration", "text": "刀剑撞击的声音。一下。又一下。越来越慢。越来越沉。" },
          { "type": "action", "actor": "主角", "emotion": "scared", "text": "你停住了。仰头看着头顶——什么也看不见。只有声音从石壁里渗下来。" },
          { "type": "thought", "text": "是爹。" },
          { "type": "narration", "text": "最后一下特别沉。像什么东西重重砸在地上。之后就没有了。" },
          { "type": "narration", "text": "石壁上落了些灰，落在你脸上。" },
          { "type": "wait", "seconds": 1 },
          { "type": "thought", "text": "什么都听不见了。头顶上整个沈家都安静了。" },
          { "type": "action", "actor": "主角", "emotion": "neutral", "text": "你站在黑暗里。站了多久不知道。脚麻了才动。" },
          { "type": "wait", "seconds": 1 },
          { "type": "action", "actor": "主角", "emotion": "neutral", "text": "你继续往前走。走得很慢，手一直摸着石壁。摸着摸着，指尖碰到一个凹槽——不是天然的，是凿出来的，边沿很规整。" },
          { "type": "thought", "text": "暗格。父亲从来没告诉过我密道里有暗格。" },
          { "type": "action", "actor": "主角", "emotion": "neutral", "text": "你伸手进去摸。摸到一卷东西，用油纸包着，硬邦邦的，塞得很紧。你把它抽出来，塞进怀里。" },
          { "type": "thought", "text": "这是什么……" },
          { "type": "action", "actor": "主角", "emotion": "neutral", "text": "你没有打开。继续往前走。" },
          { "type": "wait", "seconds": 1 }
      ]
    },
    {
      "id": "m10_tunnel_meet",
      "background": "bg_tunnel_dark",
      "bgm": { "track": "bgm_tunnel_drone", "action": "play", "fade": 0 },
      "characters": ["阿福", "阿雁", "管家", "乳母"],
      "script": [
          { "type": "narration", "text": "密道往深处走，在中段分出一条岔路。你正要往左拐，岔路那边传来脚步声——很急，还有压低的哭声。" },
          { "type": "action", "actor": "主角", "emotion": "neutral", "text": "你站住了。背贴着石壁，屏住气。" },
          { "type": "narration", "text": "脚步声越来越近。然后你看见了一点亮光——火折子的光，在拐角晃了一下，橙黄色的，照得石壁上的水珠一闪一闪。" },
          { "type": "wait", "seconds": 0.5 },
          {
              "type": "branch",
              "condition": "protagonist_gender",
              "male": [
                  { "type": "narration", "text": "一张脸从拐角探出来。管家——阿福的爹。他一手举着火折子，一手攥着阿福的手腕，半拖半拽。" },
                  { "type": "effect", "action": "show", "target": "阿福", "pos": "center", "expr": "cry" },
                  { "type": "action", "actor": "阿福", "emotion": "cry", "text": "阿福脸上全是泪，一只手捂着自己的嘴，不敢哭出声。他看见你，手从嘴上松开——" },
                  { "type": "dialog", "speaker": "阿福", "emotion": "cry", "text": "少爷——" },
                  { "type": "action", "actor": "管家", "emotion": "cry", "text": "管家看见你，腿一软，差点跪下去。他扶着石壁站稳了，喘着粗气——" },
                  { "type": "dialog", "speaker": "管家", "emotion": "cry", "text": "少爷！您没事——太好了……太好了……" },
                  { "type": "narration", "text": "火折子的光照过来，你看见管家肋下一片暗红。他看见你在看，把手按上去——" },
                  { "type": "dialog", "speaker": "管家", "emotion": "cry", "text": "没事。挡了一下。不深。" },
                  { "type": "dialog", "speaker": "主角", "emotion": "neutral", "text": "怎么进来的？" },
                  { "type": "dialog", "speaker": "管家", "emotion": "cry", "text": "黑衣人从偏院杀过来的。我把阿福从柴房那边塞进密道——那头也有个入口。我自己挡了一刀才跑进来。" },
                  { "type": "thought", "text": "柴房那边。爹说过，家里不止一处入口。" },
                  { "type": "wait", "seconds": 0.5 },
                  { "type": "narration", "text": "管家认得路。他说这条密道是沈家祖上修的，通往城外。三个人一起往城外走。管家走得越来越慢，手一直按着肋下，血从指缝里渗出来。" },
                  { "type": "action", "actor": "阿福", "emotion": "cry", "text": "阿福一直回头看他。管家拍了拍阿福的脑袋——" },
                  { "type": "dialog", "speaker": "管家", "emotion": "cry", "text": "别回头。走你的。" },
                  { "type": "wait", "seconds": 1 },
                  { "type": "bg_change", "background": "bg_wilderness_night", "transition": "fade" },
                  { "type": "narration", "text": "走到密道尽头有一扇石门。管家推开门——门外是城外一处荒坡。月亮很亮，照着野草和远处的树。身后是城里的方向——能看见火光，天边红了一大片。" },
                  { "type": "wait", "seconds": 0.5 },
                  { "type": "action", "actor": "管家", "emotion": "cry", "text": "管家在石门处停住了。他把阿福往你身边推了推。自己靠着石门坐下来——慢慢地，像怕扯着伤口。" },
                  { "type": "dialog", "speaker": "管家", "emotion": "cry", "text": "少爷，我送不动了。" },
                  { "type": "dialog", "speaker": "主角", "emotion": "neutral", "text": "我扶你走。" },
                  { "type": "dialog", "speaker": "管家", "emotion": "cry", "text": "扶不动了。你们往南走。别走大路。" },
                  { "type": "action", "actor": "阿福", "emotion": "cry", "text": "阿福扑回去拉他爹的手——" },
                  { "type": "dialog", "speaker": "阿福", "emotion": "cry", "text": "爹——爹你起来——" },
                  { "type": "action", "actor": "管家", "emotion": "cry", "text": "管家一把攥住阿福的手腕，攥得很紧。他看着阿福，看了好一会儿——" },
                  { "type": "dialog", "speaker": "管家", "emotion": "cry", "text": "跟你少爷走。听他的话。" },
                  { "type": "dialog", "speaker": "阿福", "emotion": "cry", "text": "爹——" },
                  { "type": "dialog", "speaker": "管家", "emotion": "cry", "text": "去。" },
                  { "type": "action", "actor": "管家", "emotion": "cry", "text": "他松了手。阿福的手垂下去，又伸过来，又被他推开了。" },
                  { "type": "narration", "text": "管家靠在石门上。火折子灭了。他没再说话。" },
                  { "type": "action", "actor": "阿福", "emotion": "cry", "text": "阿福跪在石门前，浑身发抖，嘴捂着不敢哭出声。眼泪从指缝里流下来。" },
                  { "type": "action", "actor": "主角", "emotion": "neutral", "text": "你蹲下来，拉起阿福的手。他的手冰凉，指甲掐进你掌心里。" },
                  { "type": "dialog", "speaker": "主角", "emotion": "neutral", "text": "起来。走。" },
                  { "type": "effect", "action": "hide", "target": "阿福" },
                  { "type": "wait", "seconds": 1 }
              ],
              "female": [
                  { "type": "narration", "text": "一张脸从拐角探出来。乳母——阿雁的娘。她一手举着火折子，一手搂着阿雁的肩膀。" },
                  { "type": "effect", "action": "show", "target": "阿雁", "pos": "center", "expr": "cry" },
                  { "type": "action", "actor": "阿雁", "emotion": "cry", "text": "阿雁缩在乳母怀里，浑身发抖，一声不吭。她看见你，嘴唇动了动，没出声——" },
                  { "type": "action", "actor": "乳母", "emotion": "cry", "text": "乳母看见你，眼泪一下子涌出来——" },
                  { "type": "dialog", "speaker": "乳母", "emotion": "cry", "text": "小姐！谢天谢地——" },
                  { "type": "dialog", "speaker": "主角", "emotion": "neutral", "text": "怎么进来的？" },
                  { "type": "dialog", "speaker": "乳母", "emotion": "cry", "text": "黑衣人从西院杀过来的。我抱起阿雁就往柴房跑——那头有个密道入口。后头有人追，我把门关上才甩掉。" },
                  { "type": "thought", "text": "柴房那边。爹说过，家里不止一处入口。" },
                  { "type": "wait", "seconds": 0.5 },
                  { "type": "narration", "text": "火折子的光照过来，你看见乳母腰侧一片暗红，衣裳黏在身上。她看见你在看，把手按上去——" },
                  { "type": "dialog", "speaker": "乳母", "emotion": "cry", "text": "关门的时候追兵的刀从门缝里捅进来的，划了一下。" },
                  { "type": "narration", "text": "她说「划了一下」，但血已经把半边衣裳浸透了。" },
                  { "type": "narration", "text": "乳母认得路。她说这条密道是沈家祖上修的，通往城外。三个人一起往城外走。乳母走得比平时慢，手一直按着腰侧，走几步就喘。" },
                  { "type": "action", "actor": "阿雁", "emotion": "cry", "text": "阿雁一直回头看她。乳母拍了拍阿雁的背——" },
                  { "type": "dialog", "speaker": "乳母", "emotion": "cry", "text": "别回头。走你的。" },
                  { "type": "wait", "seconds": 1 },
                  { "type": "bg_change", "background": "bg_wilderness_night", "transition": "fade" },
                  { "type": "narration", "text": "走到密道尽头有一扇石门。乳母推开门——门外是城外一处荒坡。月亮很亮，照着野草和远处的树。身后是城里的方向——能看见火光，天边红了一大片。" },
                  { "type": "wait", "seconds": 0.5 },
                  { "type": "action", "actor": "乳母", "emotion": "cry", "text": "乳母在石门处停住了。她把阿雁往你身边推了推。自己靠着石门坐下来——慢慢地，手按着腰侧，脸上全是汗。" },
                  { "type": "dialog", "speaker": "乳母", "emotion": "cry", "text": "小姐，我走不动了。" },
                  { "type": "dialog", "speaker": "主角", "emotion": "neutral", "text": "我扶你走。" },
                  { "type": "dialog", "speaker": "乳母", "emotion": "cry", "text": "扶不动了。你们往南走。别走大路。" },
                  { "type": "action", "actor": "阿雁", "emotion": "cry", "text": "阿雁扑回去拉她娘的手——" },
                  { "type": "dialog", "speaker": "阿雁", "emotion": "cry", "text": "娘——娘你起来——" },
                  { "type": "action", "actor": "乳母", "emotion": "cry", "text": "乳母一把攥住阿雁的手腕，攥得很紧。她看着阿雁，看了好一会儿——" },
                  { "type": "dialog", "speaker": "乳母", "emotion": "cry", "text": "跟你小姐走。听她的话。" },
                  { "type": "dialog", "speaker": "阿雁", "emotion": "cry", "text": "娘——" },
                  { "type": "dialog", "speaker": "乳母", "emotion": "cry", "text": "去。" },
                  { "type": "action", "actor": "乳母", "emotion": "cry", "text": "她松了手。阿雁的手垂下去，又伸过来，又被她推开了。" },
                  { "type": "narration", "text": "乳母靠在石门上。火折子灭了。她没再说话。" },
                  { "type": "action", "actor": "阿雁", "emotion": "cry", "text": "阿雁跪在石门前，浑身发抖，嘴捂着不敢哭出声。眼泪从指缝里流下来。" },
                  { "type": "action", "actor": "主角", "emotion": "neutral", "text": "你蹲下来，拉起阿雁的手。她的手冰凉，指甲掐进你掌心里。" },
                  { "type": "dialog", "speaker": "主角", "emotion": "neutral", "text": "起来。走。" },
                  { "type": "effect", "action": "hide", "target": "阿雁" },
                  { "type": "wait", "seconds": 1 }
              ]
          },
          { "type": "narration", "text": "月亮很亮，身后的火光很红。" },
          { "type": "action", "actor": "主角", "emotion": "neutral", "text": "你牵着阿福/阿雁，往荒坡下面走。走了几步回头看——" },
          { "type": "narration", "text": "石门前那个人靠着门，一动不动了。" },
          { "type": "wait", "seconds": 1 }
      ]
    },
    {
      "id": "m10_temple",
      "background": "bg_ruined_temple",
      "bgm": { "track": "bgm_melancholy", "action": "play", "fade": 3 },
      "characters": ["阿福", "阿雁", "陆鼎臣"],
      "script": [
          { "type": "bg_change", "background": "bg_ruined_temple", "transition": "fade" },
          { "type": "narration", "text": "走了很久。不知道多久。天黑着，月亮慢慢挪到了西边。阿福/阿雁走不动了，你拉着他/她，看见前面有一处破庙——半面墙塌了，里面堆着枯草。" },
          { "type": "action", "actor": "主角", "emotion": "neutral", "text": "你扶着阿福/阿雁走进去，靠着没塌的那面墙坐下来。浑身是伤——密道里磕的、撞的、手上石壁磨破的。膝盖也破了，血和泥糊在一起。" },
          { "type": "wait", "seconds": 0.5 },
          {
              "type": "branch",
              "condition": "protagonist_gender",
              "male": [
                  { "type": "effect", "action": "show", "target": "阿福", "pos": "right", "expr": "cry" },
                  { "type": "action", "actor": "阿福", "emotion": "cry", "text": "阿福缩在你旁边，攥着你的衣角，指节发白。他抖了好一阵，忽然从怀里掏出一个纸包——" },
                  { "type": "action", "actor": "阿福", "emotion": "cry", "text": "纸已经皱了，上面沾着血迹和泥。他打开——糖块碎了，干果也碎了，混着纸屑。最底下那几块桂花糖也碎了，黏在油纸上，化了一半。是秋祭那晚偷藏的祭祖供品。" },
                  { "type": "dialog", "speaker": "阿福", "emotion": "cry", "text": "少爷……我害怕……" },
                  { "type": "dialog", "speaker": "主角", "emotion": "neutral", "text": "你看着他手里的碎糖块。" },
                  { "type": "dialog", "speaker": "阿福", "emotion": "cry", "text": "这是沈家的……祭祖的……我揣了一直没舍得吃……" },
                  { "type": "thought", "text": "桂花糖搁在最底下。她说留到最后吃。" },
                  { "type": "dialog", "speaker": "主角", "emotion": "neutral", "text": "别怕。有我在。" },
                  { "type": "action", "actor": "阿福", "emotion": "cry", "text": "阿福抽噎着点头。他用袖子擦了一把脸，擦得更脏了——" },
                  { "type": "dialog", "speaker": "阿福", "emotion": "cry", "text": "我爹死在沈家。我哪也不去。" },
                  { "type": "effect", "action": "hide", "target": "阿福" }
              ],
              "female": [
                  { "type": "effect", "action": "show", "target": "阿雁", "pos": "right", "expr": "cry" },
                  { "type": "action", "actor": "阿雁", "emotion": "cry", "text": "阿雁缩在你旁边，攥着你的衣角，指节发白。她抖了好一阵，忽然从怀里掏出一个纸包——" },
                  { "type": "action", "actor": "阿雁", "emotion": "cry", "text": "纸已经皱了，上面沾着血迹和泥。她打开——糖块碎了，干果也碎了，混着纸屑。最底下那几块桂花糖也碎了，黏在油纸上，化了一半。是秋祭那晚偷藏的祭祖供品。" },
                  { "type": "dialog", "speaker": "阿雁", "emotion": "cry", "text": "小姐……我怕……" },
                  { "type": "dialog", "speaker": "主角", "emotion": "neutral", "text": "你看着她手里的碎糖块。" },
                  { "type": "dialog", "speaker": "阿雁", "emotion": "cry", "text": "这是沈家的……祭祖的……我揣了一直没舍得吃……" },
                  { "type": "thought", "text": "桂花糖搁在最底下。她说留到最后吃。" },
                  { "type": "dialog", "speaker": "主角", "emotion": "neutral", "text": "别怕。有我在。" },
                  { "type": "action", "actor": "阿雁", "emotion": "cry", "text": "阿雁咬着嘴唇点头。她用袖子擦了一把脸，擦得更脏了——" },
                  { "type": "dialog", "speaker": "阿雁", "emotion": "cry", "text": "我娘死在沈家。我哪也不去。" },
                  { "type": "effect", "action": "hide", "target": "阿雁" }
              ]
          },
          { "type": "wait", "seconds": 1 },
          {
              "type": "branch",
              "condition": "protagonist_gender",
              "male": [
                  { "type": "action", "actor": "主角", "emotion": "neutral", "text": "你低头看了一眼怀里。花灯还在——跑的时候一直攥着，纸糊的灯面塌了一半，灯架歪了，竹骨断了两根。灯架底部的「沈」字还在，刻痕被血蹭糊了一点。" },
                  { "type": "thought", "text": "她说别弄丢了。" },
                  { "type": "action", "actor": "主角", "emotion": "neutral", "text": "你把花灯塞回怀里。" }
              ],
              "female": [
                  { "type": "action", "actor": "主角", "emotion": "neutral", "text": "你低头看了一眼怀里。竹扇还在——跑的时候一直攥着，扇骨裂了一道，扇面上那首诗被血蹭糊了一角。竹节上那个像泪滴的斑点还在。" },
                  { "type": "thought", "text": "他说留着吧。" },
                  { "type": "action", "actor": "主角", "emotion": "neutral", "text": "你把竹扇塞回怀里。" }
              ]
          },
          { "type": "action", "actor": "主角", "emotion": "neutral", "text": "怀里那个油纸包也还在——密道暗格里摸出来的，硬邦邦的，不知道是什么。帕子还在——长姐绣的那方，上面是你的脸。你摸了摸帕子角，角上绣的那朵小花还在。" },
          { "type": "thought", "text": "她绣了五六版才绣成。" },
          { "type": "wait", "seconds": 1 },
          { "type": "narration", "text": "天快亮了。东边的天泛了一点灰白。" },
          { "type": "narration", "text": "远处传来马蹄声。先是几声，后来越来越多，混着人声。" },
          { "type": "action", "actor": "阿福", "emotion": "scared", "text": "阿福/阿雁一下子攥紧了你的衣角——" },
          { "type": "wait", "seconds": 0.5 },
          { "type": "effect", "action": "show", "target": "陆鼎臣", "pos": "center", "expr": "stern" },
          { "type": "action", "actor": "陆鼎臣", "emotion": "stern", "text": "马蹄声停在庙外。脚步声踩着枯草过来。一个身影出现在塌了的墙口——陆鼎臣。他穿着外衫，腰间佩着官印，身后跟着几个护卫。" },
          { "type": "action", "actor": "陆鼎臣", "emotion": "stern", "text": "他看见你——蜷在墙角，浑身是伤，旁边缩着阿福/阿雁，手里攥着你的衣角。他站了一息。脸上什么表情都没有。" },
          { "type": "wait", "seconds": 0.5 },
          { "type": "action", "actor": "陆鼎臣", "emotion": "stern", "text": "他走进来，蹲到你面前。他看了看你怀里的花灯/竹扇，又看了看帕子角，没问。他脱下外衫，披在你身上——外衫是暖的，带着他的体温。" },
          { "type": "dialog", "speaker": "陆鼎臣", "emotion": "stern", "text": "跟我走。" },
          { "type": "dialog", "speaker": "主角", "emotion": "neutral", "text": "……我爹……我娘……我姐……" },
          { "type": "action", "actor": "陆鼎臣", "emotion": "stern", "text": "他没答。他站起来，回头朝护卫看了一眼——" },
          { "type": "dialog", "speaker": "陆鼎臣", "emotion": "stern", "text": "封路。沈家的事，不许任何人传出去。" },
          { "type": "action", "actor": "陆鼎臣", "emotion": "stern", "text": "他转回来，伸手把你拉起来。又示意护卫把阿福/阿雁裹上。" },
          { "type": "wait", "seconds": 1 },
          { "type": "narration", "text": "你跟着陆鼎臣走出破庙。外面天亮了一半，东边的云烧成了灰色。远处的天际线上，还能看见一点火光的残红。" },
          { "type": "effect", "action": "hide", "target": "陆鼎臣" },
          { "type": "wait", "seconds": 2 }
      ]
    }
  ]
}
