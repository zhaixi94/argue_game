    {
      "id": "m06_evening_farewell",
      "background": "bg_shenjia_courtyard_evening",
      "bgm": { "track": "bgm_shenjia_evening", "action": "play", "fade": 2 },
      "characters": ["陆子衡", "陆芷薇", "陆承渊", "阿福", "阿雁"],
      "script": [
          { "type": "bg_change", "background": "bg_shenjia_courtyard_evening", "transition": "fade" },
          { "type": "narration", "text": "院里的灯笼亮着，橘黄的光在风里晃了晃。母亲在灶房里收拾，长姐帮着洗碗，碗碟碰在一起的声响叮叮当当的。檐下的燕子叽叽喳喳地叫着，正归巢。" },
          { "type": "effect", "action": "show", "target": "陆子衡", "pos": "center", "expr": "cheerful" },
          { "type": "narration", "text": "陆子衡要走了。他在院门口磨蹭了半天，忽然翻遍口袋——" },
          { "type": "action", "actor": "陆子衡", "emotion": "cheerful", "text": "他掏出一把酸枣，塞到你手里——" },
          { "type": "dialog", "speaker": "陆子衡", "emotion": "cheerful", "text": "山上摘的。别跟你姐说，她又要念叨我乱跑。" },
          { "type": "dialog", "speaker": "主角", "emotion": "neutral", "text": "你又跑山上去了？" },
          { "type": "dialog", "speaker": "陆子衡", "emotion": "cheerful", "text": "就近就近！就在城边那座小山坡。" },
          { "type": "action", "actor": "陆子衡", "emotion": "cheerful", "text": "他嘿嘿笑了两声，转身要走，又回头——" },
          { "type": "dialog", "speaker": "陆子衡", "emotion": "cheerful", "text": "下回我带你去！" },
          { "type": "effect", "action": "hide", "target": "陆子衡" },
          { "type": "narration", "text": "陆子衡跑了。院门口的脚步声渐渐远了。" },
          {
              "type": "branch",
              "condition": "protagonist_gender",
              "male": [
                  { "type": "effect", "action": "show", "target": "陆芷薇", "pos": "right", "expr": "neutral" },
                  { "type": "action", "actor": "陆芷薇", "emotion": "neutral", "text": "陆芷薇走在最后面，路过你的时候站住了，双手背在身后，大大方方地看着你——" },
                  { "type": "dialog", "speaker": "陆芷薇", "emotion": "neutral", "text": "生辰吉乐。十四了，别老跟子衡似的爬树，没个正形。" },
                  { "type": "dialog", "speaker": "主角", "emotion": "neutral", "text": "你也管我。" },
                  { "type": "action", "actor": "陆芷薇", "emotion": "cheerful", "text": "陆芷薇哼了一声，转身走了，辫子在背上甩了甩。走了几步又回头——" },
                  { "type": "dialog", "speaker": "陆芷薇", "emotion": "cheerful", "text": "下回来给你带陆家后院的石榴，熟了。" },
                  { "type": "thought", "text": "她总是这样，嘴上不饶人，走的时候还要回头补一句。" },
                  { "type": "effect", "action": "hide", "target": "陆芷薇" }
              ],
              "female": [
                  { "type": "effect", "action": "show", "target": "陆承渊", "pos": "right", "expr": "neutral" },
                  { "type": "action", "actor": "陆承渊", "emotion": "neutral", "text": "陆承渊走在最后面，路过你的时候停了一步。他没看你，声音不大——" },
                  { "type": "dialog", "speaker": "陆承渊", "emotion": "neutral", "text": "生辰吉乐。" },
                  { "type": "action", "actor": "主角", "emotion": "neutral", "text": "你愣了一下。等你想应一声的时候，他已经走远了，背影在巷子里越来越暗。" },
                  { "type": "thought", "text": "他刚才……说什么了？" },
                  { "type": "effect", "action": "hide", "target": "陆承渊" }
              ]
          },
          { "type": "narration", "text": "院里安静下来了。你站在廊下，手里攥着那把酸枣，袖子里揣着两方帕子。" },
          { "type": "thought", "text": "十四岁了。那杯酒，还搁在堂屋桌上。" },
          {
              "type": "branch",
              "condition": "protagonist_gender",
              "male": [
                  { "type": "effect", "action": "show", "target": "阿福", "pos": "left", "expr": "shy" },
                  { "type": "action", "actor": "阿福", "emotion": "shy", "text": "阿福从灶房端着一碟剩糕出来，递给你——" },
                  { "type": "dialog", "speaker": "阿福", "emotion": "shy", "text": "少爷，最后一块桂花糕了。夫人说留给你的。" },
                  { "type": "effect", "action": "hide", "target": "阿福" }
              ],
              "female": [
                  { "type": "effect", "action": "show", "target": "阿雁", "pos": "left", "expr": "shy" },
                  { "type": "action", "actor": "阿雁", "emotion": "shy", "text": "阿雁从灶房端着一碟剩糕出来，递给你——" },
                  { "type": "dialog", "speaker": "阿雁", "emotion": "shy", "text": "小姐，最后一块桂花糕了。夫人说留给你的。" },
                  { "type": "effect", "action": "hide", "target": "阿雁" }
              ]
          },
          { "type": "wait", "seconds": 0.5 },
