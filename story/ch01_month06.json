{
  "chapter": "第1期·新手教学",
  "month": 6,
  "title": "生辰·桂花",
  "quest": "quest_m06",
  "scenes": [
    {
      "id": "m06_birthday_morning",
      "background": "bg_shenjia_courtyard_morning",
      "bgm": { "track": "bgm_shenjia_morning", "action": "play", "fade": 2 },
      "characters": ["柳蕙心", "阿福", "阿雁"],
      "script": [
          { "type": "bg_change", "background": "bg_shenjia_courtyard_morning", "transition": "fade" },
          { "type": "narration", "text": "天还没亮透，灶房那头就闹腾起来了。锅铲碰着灶沿的声响、蒸笼掀开时嗤的一声、桂花碾进面里的甜香——一阵一阵地飘进窗来。" },
          { "type": "thought", "text": "什么味道……桂花糕？" },
          { "type": "action", "actor": "主角", "emotion": "neutral", "text": "你翻身坐起来，揉了揉眼。今日是你的生辰。" },
          {
              "type": "branch",
              "condition": "protagonist_gender",
              "male": [
                  { "type": "effect", "action": "show", "target": "阿福", "pos": "left", "expr": "cheerful" },
                  { "type": "action", "actor": "阿福", "emotion": "cheerful", "vfx": "bounce", "text": "门帘一掀，阿福冲进来了，比你还急——" },
                  { "type": "dialog", "speaker": "阿福", "emotion": "cheerful", "text": "少爷！生辰吉乐！" },
                  { "type": "action", "actor": "阿福", "emotion": "cheerful", "text": "他从身后变戏法似的掏出一个油纸包，往你手里一塞——" },
                  { "type": "dialog", "speaker": "阿福", "emotion": "cheerful", "text": "巷口那家的！我一大早去排的，还热着呢。" },
                  { "type": "narration", "text": "油纸包还烫手。是你最爱吃的那家枣泥酥，铺子开在巷口拐角，每日只做一锅，去晚了就没了。" },
                  { "type": "dialog", "speaker": "主角", "emotion": "neutral", "text": "你几点去的？" },
                  { "type": "dialog", "speaker": "阿福", "emotion": "shy", "text": "也没多早……天还没亮就去了。揣怀里跑回来的，怕凉了。" },
                  { "type": "action", "actor": "主角", "emotion": "neutral", "text": "你捏了一块，酥皮碎了满手。阿福在旁边看着你吃，自己咽了咽口水，但没伸手。" },
                  { "type": "dialog", "speaker": "主角", "emotion": "neutral", "text": "你也吃。" },
                  { "type": "dialog", "speaker": "阿福", "emotion": "shy", "text": "我吃过了！……真吃过了。" },
                  { "type": "thought", "text": "他嘴角什么都没有，分明没吃过。" }
              ],
              "female": [
                  { "type": "effect", "action": "show", "target": "阿雁", "pos": "left", "expr": "cheerful" },
                  { "type": "action", "actor": "阿雁", "emotion": "cheerful", "vfx": "bounce", "text": "门帘一掀，阿雁进来了，脸上带着笑——" },
                  { "type": "dialog", "speaker": "阿雁", "emotion": "cheerful", "text": "小姐，生辰吉乐！" },
                  { "type": "action", "actor": "阿雁", "emotion": "cheerful", "text": "她从身后掏出一个油纸包，双手递到你面前——" },
                  { "type": "dialog", "speaker": "阿雁", "emotion": "cheerful", "text": "巷口那家的枣泥酥，一大早去排的，还热着呢。" },
                  { "type": "narration", "text": "油纸包还烫手。是你最爱吃的那家枣泥酥，铺子开在巷口拐角，每日只做一锅，去晚了就没了。" },
                  { "type": "dialog", "speaker": "主角", "emotion": "neutral", "text": "你几点去的？" },
                  { "type": "dialog", "speaker": "阿雁", "emotion": "shy", "text": "天还没亮就去了。揣怀里跑回来的，怕凉了。" },
                  { "type": "action", "actor": "主角", "emotion": "neutral", "text": "你捏了一块，酥皮碎了满手。阿雁在旁边看着你吃，自己咽了咽口水，但没伸手。" },
                  { "type": "dialog", "speaker": "主角", "emotion": "neutral", "text": "你也吃。" },
                  { "type": "dialog", "speaker": "阿雁", "emotion": "shy", "text": "我吃过了……" },
                  { "type": "thought", "text": "她嘴角什么都没有，分明没吃过。" }
              ]
          },
          { "type": "effect", "action": "hide", "target": "阿福" },
          { "type": "effect", "action": "hide", "target": "阿雁" },
          { "type": "wait", "seconds": 0.5 },
          { "type": "bg_change", "background": "bg_shenjia_kitchen", "transition": "fade" },
          { "type": "effect", "action": "show", "target": "柳蕙心", "pos": "right", "expr": "gentle" },
          { "type": "narration", "text": "你洗了脸去了灶房。母亲正蹲在灶前看蒸笼，围裙上沾了一身的桂花碎。案板上摆着好几屉糕，有的刚出笼，有的还在晾。" },
          { "type": "dialog", "speaker": "柳蕙心", "emotion": "gentle", "text": "来了？今日做了桂花糕，你最爱吃的。晚上摆席的时候用，剩下给你留着慢慢吃。" },
          { "type": "action", "actor": "柳蕙心", "emotion": "gentle", "text": "她站起来，拿帕子擦了擦手，从案上拈了一块刚出笼的递给你——" },
          { "type": "dialog", "speaker": "柳蕙心", "emotion": "gentle", "text": "先尝一块，烫，慢点吃。" },
          { "type": "action", "actor": "主角", "emotion": "neutral", "text": "你接过来咬了一口，桂花馅还是甜的，皮子软得化嘴。母亲看着你吃，拿手背蹭了蹭额头的汗。" },
          { "type": "dialog", "speaker": "柳蕙心", "emotion": "gentle", "text": "十四了。一眨眼的事。" },
          { "type": "action", "actor": "柳蕙心", "emotion": "gentle", "text": "她顿了一下，又转过身去揭蒸笼——" },
          { "type": "dialog", "speaker": "柳蕙心", "emotion": "gentle", "text": "今日客人多，你二叔一早就来了，你长姐也在堂屋候着。惠芳姨带着若兰也到了。去堂屋看看吧。" },
          { "type": "effect", "action": "hide", "target": "柳蕙心" },
          { "type": "wait", "seconds": 0.5 }
      ]
    },
    {
      "id": "m06_birthday_gifts",
      "background": "bg_shenjia_hall",
      "bgm": { "track": "bgm_shenjia_warm", "action": "play", "fade": 2 },
      "characters": ["沈伯远", "柳蕙心", "沈婉清", "沈伯宁", "苏若兰", "苏怀瑾", "柳惠芳", "阿福", "阿雁"],
      "script": [
          { "type": "bg_change", "background": "bg_shenjia_hall", "transition": "fade" },
          { "type": "narration", "text": "堂屋里已经热闹起来了。二叔坐在椅子上翘着腿喝茶，长姐在旁边理桌布，惠芳姨坐在客座上跟母亲说话——两家走动惯了，也没什么客套。苏若兰/苏怀瑾安静地坐在惠芳姨身边。" },
          { "type": "effect", "action": "show", "target": "沈伯宁", "pos": "left", "expr": "cheerful" },
          { "type": "action", "actor": "沈伯宁", "emotion": "cheerful", "vfx": "bounce", "text": "你刚进门，二叔就站起来了，手里举着一个糖人，是只兔子，举得高高的怕碰碎了——" },
          { "type": "dialog", "speaker": "沈伯宁", "emotion": "cheerful", "text": "生辰吉乐！来来来，看看叔给你挑的，集市上最大的！" },
          { "type": "action", "actor": "主角", "emotion": "neutral", "text": "你接过糖人。兔子做得歪歪扭扭的，但糖丝拉得很细，太阳底下亮晶晶的。" },
          { "type": "dialog", "speaker": "主角", "emotion": "neutral", "text": "谢谢二叔。" },
          { "type": "action", "actor": "沈伯宁", "emotion": "cheerful", "text": "二叔笑着摆了摆手，又坐回去。" },
          { "type": "narration", "text": "你注意到他衣裳还是上回那件，袖口的线头又多了几根，洗得有些发白了。" },
          { "type": "action", "actor": "沈伯宁", "emotion": "cheerful", "text": "他坐下的时候摸了摸口袋，掏了半天，才摸出几枚铜板搁在桌上——" },
          { "type": "dialog", "speaker": "沈伯宁", "emotion": "cheerful", "text": "叔今年手头紧，先欠着，下回补你个大的。" },
          { "type": "thought", "text": "二叔腰间那个旧荷包换了根绳子，系法跟旁人不一样，像是别人帮系的。荷包瘪瘪的，几乎没鼓起来。" },
          { "type": "effect", "action": "hide", "target": "沈伯宁" },
          { "type": "wait", "seconds": 0.5 },
          { "type": "effect", "action": "show", "target": "沈婉清", "pos": "right", "expr": "gentle" },
          { "type": "action", "actor": "沈婉清", "emotion": "gentle", "text": "长姐从廊下过来，手里捏着一样东西，走到你面前——" },
          { "type": "dialog", "speaker": "沈婉清", "emotion": "gentle", "text": "生辰吉乐。" },
          { "type": "action", "actor": "沈婉清", "emotion": "gentle", "text": "她递过来一方帕子，叠得整整齐齐的。你接过来展开——" },
          { "type": "narration", "text": "帕子上绣着一个人。眉眼一笔一笔的，针脚很细。你看了半天，才看出来——绣的是你。" },
          { "type": "thought", "text": "这是我？眉眼之间……好像还有点她的影子？" },
          { "type": "dialog", "speaker": "主角", "emotion": "neutral", "text": "这……绣了好久吧？" },
          { "type": "dialog", "speaker": "沈婉清", "emotion": "gentle", "text": "绣了好久。你看像不像？" },
          { "type": "action", "actor": "主角", "emotion": "neutral", "text": "你翻来覆去看了半天，歪着头——" },
          { "type": "dialog", "speaker": "主角", "emotion": "neutral", "text": "有点像……嘴角不太像。" },
          { "type": "action", "actor": "沈婉清", "emotion": "cheerful", "text": "长姐笑了，伸手点了点你的嘴角——" },
          { "type": "dialog", "speaker": "沈婉清", "emotion": "cheerful", "text": "你笑起来嘴角往下弯，跟爹一个样。我绣了三遍才绣对。" },
          { "type": "action", "actor": "主角", "emotion": "neutral", "text": "你把帕子攥在手里，没舍得放下。帕子角上绣了一小簇桂花，跟灶房里蒸糕的香味一模一样。" },
          { "type": "effect", "action": "hide", "target": "沈婉清" },
          { "type": "wait", "seconds": 0.5 },
          {
              "type": "branch",
              "condition": "protagonist_gender",
              "male": [
                  { "type": "effect", "action": "show", "target": "苏若兰", "pos": "center", "expr": "neutral" },
                  { "type": "action", "actor": "苏若兰", "emotion": "neutral", "text": "苏若兰从惠芳姨身边站起来，走到你面前行了个礼，手里捧着一个小布包——" },
                  { "type": "dialog", "speaker": "苏若兰", "emotion": "neutral", "text": "表弟，生辰吉乐。" },
                  { "type": "action", "actor": "苏若兰", "emotion": "neutral", "text": "她把布包递过来，递的时候垂着眼，没看你。你接了，打开——里面是一方帕子，角上绣着一簇桂花，针脚细密，花瓣的颜色深浅不一，像是真花瓣贴上去的。" },
                  { "type": "thought", "text": "也是桂花。跟长姐绣的不一样……长姐绣的是我，她绣的是花。" },
                  { "type": "dialog", "speaker": "主角", "emotion": "neutral", "text": "……谢谢。" },
                  { "type": "action", "actor": "苏若兰", "emotion": "neutral", "text": "她点了点头，嘴角弯了一下，转身退回惠芳姨身边去了。" },
                  { "type": "effect", "action": "show", "target": "柳惠芳", "pos": "right", "expr": "gentle" },
                  { "type": "action", "actor": "柳惠芳", "emotion": "gentle", "text": "惠芳姨笑着拍了拍苏若兰的肩，又看向你——" },
                  { "type": "dialog", "speaker": "柳惠芳", "emotion": "gentle", "text": "若兰这孩子心思细，帕子上的花样子她自己描了三回才满意。你姨妈我可不会绣这个，随她妈。" },
                  { "type": "dialog", "speaker": "柳蕙心", "emotion": "gentle", "text": "你绣的那个鸭子我到现在还记得，像只鹅。" },
                  { "type": "action", "actor": "柳惠芳", "emotion": "cheerful", "text": "惠芳姨瞪了母亲一眼，两人都笑了。" },
                  { "type": "effect", "action": "hide", "target": "柳惠芳" },
                  { "type": "action", "actor": "主角", "emotion": "neutral", "text": "你拿着帕子翻来覆去看了半天——" },
                  { "type": "effect", "action": "show", "target": "阿福", "pos": "left", "expr": "cheerful" },
                  { "type": "action", "actor": "阿福", "emotion": "cheerful", "text": "阿福站在廊柱边上，看见你翻来覆去地看帕子，挠了挠头——" },
                  { "type": "dialog", "speaker": "阿福", "emotion": "cheerful", "text": "少爷，那帕子……挺好。" },
                  { "type": "thought", "text": "他什么都没问，但那眼神分明在说——少爷今天笑得跟平时不一样。" },
                  { "type": "action", "actor": "主角", "emotion": "neutral", "text": "你赶紧把帕子揣进袖子里，清了清嗓子。" },
                  { "type": "dialog", "speaker": "阿福", "emotion": "cheerful", "text": "阿福别过头去，假装看院子里的树，嘴角咧着。" },
                  { "type": "effect", "action": "hide", "target": "阿福" }
              ],
              "female": [
                  { "type": "effect", "action": "show", "target": "苏怀瑾", "pos": "center", "expr": "neutral" },
                  { "type": "action", "actor": "苏怀瑾", "emotion": "neutral", "text": "苏怀瑾从惠芳姨身边站起来，走到你面前行了个礼。你注意到他指尖上还沾着墨——方才在廊下写字来着。他从袖中取出一个小布包，码得整整齐齐的——" },
                  { "type": "dialog", "speaker": "苏怀瑾", "emotion": "neutral", "text": "表妹，生辰吉乐。" },
                  { "type": "action", "actor": "苏怀瑾", "emotion": "neutral", "text": "他把布包递过来，递的时候看了你一眼，又移开了。你接了，打开——里面是一方帕子，角上绣着一簇桂花，针脚细密，花瓣的颜色深浅不一，像是真花瓣贴上去的。" },
                  { "type": "thought", "text": "也是桂花。跟长姐绣的不一样……长姐绣的是我，他绣的是花。" },
                  { "type": "dialog", "speaker": "主角", "emotion": "neutral", "text": "……谢谢。" },
                  { "type": "action", "actor": "苏怀瑾", "emotion": "neutral", "text": "他点了点头，又从袖中摸出一支小竹签——" },
                  { "type": "dialog", "speaker": "苏怀瑾", "emotion": "neutral", "text": "帕子上的桂花，是我自己画的样子再让人绣的。这支竹签……就当添头吧。" },
                  { "type": "action", "actor": "主角", "emotion": "neutral", "text": "你接过来，竹签上刻了一小簇桂花，刻痕还是新的。他转身退回惠芳姨身边去了。" },
                  { "type": "effect", "action": "show", "target": "柳惠芳", "pos": "right", "expr": "gentle" },
                  { "type": "action", "actor": "柳惠芳", "emotion": "gentle", "text": "惠芳姨笑着拍了拍苏怀瑾的肩，又看向你——" },
                  { "type": "dialog", "speaker": "柳惠芳", "emotion": "gentle", "text": "怀瑾这孩子，一路上就在船上描花样，描了一路。到了你家也没闲着，天天在廊下刻那竹签。" },
                  { "type": "dialog", "speaker": "柳蕙心", "emotion": "gentle", "text": "跟你小时候一个样，坐不住，手里非得攥着笔。" },
                  { "type": "action", "actor": "柳惠芳", "emotion": "cheerful", "text": "惠芳姨摇了摇头，笑了。母亲也笑了。" },
                  { "type": "effect", "action": "hide", "target": "柳惠芳" },
                  { "type": "action", "actor": "主角", "emotion": "neutral", "text": "你拿着帕子和竹签翻来覆去看了半天——" },
                  { "type": "effect", "action": "show", "target": "阿雁", "pos": "left", "expr": "cheerful" },
                  { "type": "action", "actor": "阿雁", "emotion": "cheerful", "vfx": "nudge", "text": "阿雁不知什么时候凑过来的，探着身子——" },
                  { "type": "dialog", "speaker": "阿雁", "emotion": "cheerful", "text": "小姐，谁送的呀？我看看——" },
                  { "type": "action", "actor": "主角", "emotion": "neutral", "text": "你一把把帕子揣进袖子里，瞪了她一眼。" },
                  { "type": "dialog", "speaker": "阿雁", "emotion": "shy", "text": "……我就看看嘛。" },
                  { "type": "effect", "action": "hide", "target": "阿雁" }
              ]
          },
          { "type": "effect", "action": "hide", "target": "苏若兰" },
          { "type": "effect", "action": "hide", "target": "苏怀瑾" },
          { "type": "wait", "seconds": 0.5 },
          { "type": "narration", "text": "二叔还在喝茶闲扯，长姐去灶房帮母亲准备晚上的席面了。惠芳姨也去了灶房帮忙。" },
          {
              "type": "branch",
              "condition": "protagonist_gender",
              "male": [
                  { "type": "narration", "text": "苏若兰搬了把小凳子坐在廊下看书，哪儿也没去。" }
              ],
              "female": [
                  { "type": "narration", "text": "苏怀瑾搬了把小凳子坐在廊下看书，哪儿也没去。" }
              ]
          },
          { "type": "wait", "seconds": 0.5 }
      ]
    },
    {
      "id": "m06_afternoon_swallow",
      "background": "bg_shenjia_courtyard_afternoon",
      "bgm": { "track": "bgm_shenjia_afternoon", "action": "play", "fade": 2 },
      "characters": ["陆子衡", "陆芷薇", "陆承渊", "苏若兰", "苏怀瑾", "阿福", "阿雁"],
      "script": [
          { "type": "bg_change", "background": "bg_shenjia_courtyard_afternoon", "transition": "fade" },
          { "type": "narration", "text": "午后，院门口就炸开了——" },
          { "type": "effect", "action": "show", "target": "陆子衡", "pos": "center", "expr": "cheerful" },
          { "type": "action", "actor": "陆子衡", "emotion": "cheerful", "vfx": "bounce", "text": "陆子衡人还没进来，嗓门先到了——" },
          { "type": "dialog", "speaker": "陆子衡", "emotion": "cheerful", "text": "生辰吉乐！我来了！" },
          { "type": "action", "actor": "陆子衡", "emotion": "cheerful", "text": "他跑进院子，一屁股坐在石凳上，喘了口气，抬头朝你咧嘴——" },
          { "type": "dialog", "speaker": "陆子衡", "emotion": "cheerful", "text": "走，爬树去！" },
          { "type": "dialog", "speaker": "主角", "emotion": "neutral", "text": "又爬？" },
          { "type": "dialog", "speaker": "陆子衡", "emotion": "cheerful", "text": "上回你赢了，这回不算。走！" },
          { "type": "narration", "text": "两人跑到院角那棵老槐树下。陆子衡撸起袖子就往上蹿，脚在树干上一蹬一蹬的。爬到半腰，脚底一滑——" },
          { "type": "action", "actor": "陆子衡", "emotion": "scared", "vfx": "shake", "text": "扑通一声，陆子衡摔了一屁股泥。树叶哗啦啦落了一头。" },
          { "type": "dialog", "speaker": "主角", "emotion": "cheerful", "text": "跟屁虫。" },
          { "type": "dialog", "speaker": "陆子衡", "emotion": "angry", "text": "你才跟屁虫！再来！" },
          { "type": "action", "actor": "陆子衡", "emotion": "angry", "text": "他爬起来拍拍屁股，又上去了。这回学乖了，脚踩稳了再往上。到了分叉的地方，他回头朝你喊——" },
          { "type": "dialog", "speaker": "陆子衡", "emotion": "cheerful", "text": "你上来不上来？我等你！" },
          { "type": "action", "actor": "主角", "emotion": "neutral", "text": "你三两下也爬了上去，坐在他旁边的枝子上。两人坐在树杈里晃着腿，看着院里的屋顶和巷子。" },
          { "type": "dialog", "speaker": "陆子衡", "emotion": "cheerful", "text": "你看，你家的屋顶比我家矮。" },
          { "type": "dialog", "speaker": "主角", "emotion": "neutral", "text": "你家是州官的宅子，比什么比。" },
          { "type": "dialog", "speaker": "陆子衡", "emotion": "cheerful", "text": "矮也挺好。你家桂花糕好吃。" },
          {
              "type": "branch",
              "condition": "protagonist_gender",
              "male": [
                  { "type": "effect", "action": "show", "target": "苏若兰", "pos": "right", "expr": "neutral" },
                  { "type": "action", "actor": "苏若兰", "emotion": "neutral", "text": "树下传来一个声音。苏若兰不知什么时候走过来了，手里还捏着书卷，抬头看着树上的两个人——" },
                  { "type": "dialog", "speaker": "苏若兰", "emotion": "neutral", "text": "你们不嫌脏吗。" },
                  { "type": "dialog", "speaker": "陆子衡", "emotion": "cheerful", "text": "这谁？" },
                  { "type": "dialog", "speaker": "主角", "emotion": "neutral", "text": "我表姐，苏若兰，住在我家的。" },
                  { "type": "dialog", "speaker": "陆子衡", "emotion": "cheerful", "text": "哦！表姐！你也来爬树呗！" },
                  { "type": "action", "actor": "苏若兰", "emotion": "neutral", "text": "苏若兰没搭理他，低头翻了一页书，靠着树干站了。" },
                  { "type": "thought", "text": "她站在底下，阳光从树叶缝里漏下来，落在她肩上碎成一片一片的。" },
                  { "type": "dialog", "speaker": "陆子衡", "emotion": "cheerful", "text": "你表姐也不爬树，没意思。" },
                  { "type": "dialog", "speaker": "主角", "emotion": "neutral", "text": "人家看书呢，你少拉人家。" },
                  { "type": "action", "actor": "陆子衡", "emotion": "cheerful", "text": "陆子衡冲你挤了挤眼——" },
                  { "type": "dialog", "speaker": "陆子衡", "emotion": "cheerful", "text": "你护着她。" },
                  { "type": "action", "actor": "主角", "emotion": "worried", "vfx": "shake", "text": "你踹了他一脚，差点把他从树上踹下去。" },
                  { "type": "effect", "action": "hide", "target": "苏若兰" }
              ],
              "female": [
                  { "type": "effect", "action": "show", "target": "苏怀瑾", "pos": "right", "expr": "neutral" },
                  { "type": "action", "actor": "苏怀瑾", "emotion": "neutral", "text": "树下传来一个声音。苏怀瑾不知什么时候走过来了，手里捏着书卷和一支笔，抬头看了看树上的两个人，又低头看了看地上的泥——" },
                  { "type": "dialog", "speaker": "苏怀瑾", "emotion": "neutral", "text": "……你们衣服上全是泥。" },
                  { "type": "dialog", "speaker": "陆子衡", "emotion": "cheerful", "text": "这谁？" },
                  { "type": "dialog", "speaker": "主角", "emotion": "neutral", "text": "我表哥，苏怀瑾，住在我家的。" },
                  { "type": "dialog", "speaker": "陆子衡", "emotion": "cheerful", "text": "哦！表哥！你也来爬树呗！" },
                  { "type": "action", "actor": "苏怀瑾", "emotion": "neutral", "text": "苏怀瑾摇了摇头，靠着树干站了，低头在书卷上写了几个字。" },
                  { "type": "thought", "text": "他站在底下，阳光从树叶缝里漏下来，落在他肩上碎成一片一片的。他在写什么？" },
                  { "type": "dialog", "speaker": "陆子衡", "emotion": "cheerful", "text": "你表哥也不爬树，在底下写字呢，没意思。" },
                  { "type": "dialog", "speaker": "主角", "emotion": "neutral", "text": "人家写字呢，你少拉人家。" },
                  { "type": "action", "actor": "陆子衡", "emotion": "cheerful", "text": "陆子衡冲你挤了挤眼——" },
                  { "type": "dialog", "speaker": "陆子衡", "emotion": "cheerful", "text": "你护着他。" },
                  { "type": "action", "actor": "主角", "emotion": "worried", "vfx": "shake", "text": "你踹了他一脚，差点把他从树上踹下去。" },
                  { "type": "effect", "action": "hide", "target": "苏怀瑾" }
              ]
          },
          { "type": "effect", "action": "hide", "target": "陆子衡" },
          { "type": "wait", "seconds": 0.5 },
          { "type": "narration", "text": "两人从树上溜下来，陆子衡拍了拍你肩上的树皮碎——" },
          { "type": "dialog", "speaker": "陆子衡", "emotion": "cheerful", "text": "走，去看燕子。" },
          {
              "type": "branch",
              "condition": "protagonist_gender",
              "male": [
                  { "type": "dialog", "speaker": "主角", "emotion": "neutral", "text": "若兰姐，一起去后巷看燕子？" },
                  { "type": "action", "actor": "苏若兰", "emotion": "neutral", "text": "苏若兰合上书，犹豫了一下——" },
                  { "type": "dialog", "speaker": "苏若兰", "emotion": "neutral", "text": "什么燕子？" },
                  { "type": "dialog", "speaker": "陆子衡", "emotion": "cheerful", "text": "去了就知道了！走！" },
                  { "type": "action", "actor": "苏若兰", "emotion": "neutral", "text": "她没说不去，跟着走了，书卷还攥在手里。" }
              ],
              "female": [
                  { "type": "dialog", "speaker": "主角", "emotion": "neutral", "text": "怀瑾哥，一起去后巷看燕子？" },
                  { "type": "action", "actor": "苏怀瑾", "emotion": "neutral", "text": "苏怀瑾抬头想了想，把书卷和笔收进袖中——" },
                  { "type": "dialog", "speaker": "苏怀瑾", "emotion": "neutral", "text": "什么燕子？带我去看看。" },
                  { "type": "dialog", "speaker": "陆子衡", "emotion": "cheerful", "text": "走！" },
                  { "type": "action", "actor": "苏怀瑾", "emotion": "neutral", "text": "他自己就跟上了，不用人拽。" }
              ]
          },
          { "type": "bg_change", "background": "bg_back_alley", "transition": "fade" },
          { "type": "narration", "text": "三人溜到后巷，还没走到老槐树底下，就看见树洞旁边蹲着一个人影——" },
          {
              "type": "branch",
              "condition": "protagonist_gender",
              "male": [
                  { "type": "effect", "action": "show", "target": "阿福", "pos": "left", "expr": "shy" },
                  { "type": "action", "actor": "阿福", "emotion": "shy", "text": "阿福正踮着脚往树洞里搁碎米，听见脚步声回头一看，赶紧招手让他们小声些——" },
                  { "type": "dialog", "speaker": "阿福", "emotion": "shy", "text": "嘘——别吵，刚吃着呢。" },
                  { "type": "action", "actor": "陆子衡", "emotion": "cheerful", "text": "陆子衡凑过去，扒着树洞往里看——" },
                  { "type": "dialog", "speaker": "陆子衡", "emotion": "cheerful", "text": "哟，大了不少！毛都换了一茬。" },
                  { "type": "action", "actor": "阿福", "emotion": "shy", "text": "阿福从怀里掏出一小把碎米，撒在树洞边上——" },
                  { "type": "dialog", "speaker": "阿福", "emotion": "shy", "text": "前几天还能飞两步了，扑棱着翅膀从洞里探出头，又缩回去了。胆子小得很。" },
                  { "type": "narration", "text": "你探头看了看——雏燕比上回大了不少，绒毛褪得差不多了，翅膀上的硬羽长了出来。它看见你，扑棱了两下翅膀，从树洞里探出半个身子，又缩了回去。" },
                  { "type": "dialog", "speaker": "陆子衡", "emotion": "cheerful", "text": "等它能飞了就放它走。" },
                  { "type": "dialog", "speaker": "主角", "emotion": "neutral", "text": "再等等。翅膀还没硬。" },
                  { "type": "effect", "action": "show", "target": "苏若兰", "pos": "right", "expr": "neutral" },
                  { "type": "action", "actor": "苏若兰", "emotion": "neutral", "text": "苏若兰站在你身后，探头往树洞里看了一眼，又退了半步——" },
                  { "type": "dialog", "speaker": "苏若兰", "emotion": "neutral", "text": "它认得你们。" },
                  { "type": "thought", "text": "仔细一看，雏燕确实不怕阿福，但苏若兰一凑近它就缩了。是认人。" },
                  { "type": "dialog", "speaker": "陆子衡", "emotion": "cheerful", "text": "当然认得！我们天天来喂它。" },
                  { "type": "action", "actor": "苏若兰", "emotion": "neutral", "text": "苏若兰没说话，站远了一些，静静地看着你们喂。过了一会儿，轻轻开口——" },
                  { "type": "dialog", "speaker": "苏若兰", "emotion": "neutral", "text": "等它飞走了，你们会难过吗？" },
                  { "type": "effect", "action": "hide", "target": "苏若兰" },
                  { "type": "effect", "action": "show", "target": "陆芷薇", "pos": "right", "expr": "neutral" },
                  { "type": "action", "actor": "陆芷薇", "emotion": "neutral", "text": "巷子口传来脚步声。陆芷薇走过来，看见你们蹲在树底下，挑了挑眉——" },
                  { "type": "dialog", "speaker": "陆芷薇", "emotion": "neutral", "text": "又在这儿偷看。" },
                  { "type": "dialog", "speaker": "陆子衡", "emotion": "cheerful", "text": "嘘！你小点声！" },
                  { "type": "action", "actor": "陆芷薇", "emotion": "neutral", "text": "陆芷薇翻了个白眼，走过来蹲在陆子衡旁边，往树洞里看了一眼——" },
                  { "type": "dialog", "speaker": "陆芷薇", "emotion": "neutral", "text": "伤好了？" },
                  { "type": "dialog", "speaker": "主角", "emotion": "neutral", "text": "好了不少。能扑腾了。" },
                  { "type": "action", "actor": "陆芷薇", "emotion": "neutral", "text": "她点了点头，站起来四处看了看——" },
                  { "type": "dialog", "speaker": "陆芷薇", "emotion": "neutral", "text": "我帮你们望风。有人来了我咳嗽一声。" },
                  { "type": "effect", "action": "hide", "target": "陆芷薇" },
                  { "type": "effect", "action": "hide", "target": "阿福" }
              ],
              "female": [
                  { "type": "effect", "action": "show", "target": "阿雁", "pos": "left", "expr": "shy" },
                  { "type": "action", "actor": "阿雁", "emotion": "shy", "text": "阿雁正踮着脚往树洞里搁碎米，听见脚步声回头一看，赶紧招手让他们小声些——" },
                  { "type": "dialog", "speaker": "阿雁", "emotion": "shy", "text": "嘘——别吵，刚吃着呢。" },
                  { "type": "action", "actor": "陆子衡", "emotion": "cheerful", "text": "陆子衡凑过去，扒着树洞往里看——" },
                  { "type": "dialog", "speaker": "陆子衡", "emotion": "cheerful", "text": "哟，大了不少！毛都换了一茬。" },
                  { "type": "action", "actor": "阿雁", "emotion": "shy", "text": "阿雁从怀里掏出一小把碎米，撒在树洞边上——" },
                  { "type": "dialog", "speaker": "阿雁", "emotion": "shy", "text": "前几天还能飞两步了，扑棱着翅膀从洞里探出头，又缩回去了。胆子小得很。" },
                  { "type": "narration", "text": "你探头看了看——雏燕比上回大了不少，绒毛褪得差不多了，翅膀上的硬羽长了出来。它看见你，扑棱了两下翅膀，从树洞里探出半个身子，又缩了回去。" },
                  { "type": "dialog", "speaker": "陆子衡", "emotion": "cheerful", "text": "等它能飞了就放它走。" },
                  { "type": "dialog", "speaker": "主角", "emotion": "neutral", "text": "再等等。翅膀还没硬。" },
                  { "type": "effect", "action": "show", "target": "苏怀瑾", "pos": "right", "expr": "neutral" },
                  { "type": "action", "actor": "苏怀瑾", "emotion": "neutral", "text": "苏怀瑾蹲到你旁边，往树洞里看了一眼，又看了看阿雁手里的碎米——" },
                  { "type": "dialog", "speaker": "苏怀瑾", "emotion": "neutral", "text": "它认得你们。" },
                  { "type": "thought", "text": "仔细一看，雏燕确实不怕阿雁，但苏怀瑾一凑近它就缩了。是认人。" },
                  { "type": "dialog", "speaker": "陆子衡", "emotion": "cheerful", "text": "当然认得！我们天天来喂它。" },
                  { "type": "action", "actor": "苏怀瑾", "emotion": "neutral", "text": "苏怀瑾没说话，从袖子里摸出一小把碎米，搁在树洞边上。雏燕探出头看了看，没动。他也不恼，把手里的碎米推了推，离树洞更近了些——" },
                  { "type": "dialog", "speaker": "苏怀瑾", "emotion": "neutral", "text": "不急。多来几次就认得了。" },
                  { "type": "effect", "action": "hide", "target": "苏怀瑾" },
                  { "type": "effect", "action": "show", "target": "陆承渊", "pos": "right", "expr": "neutral" },
                  { "type": "action", "actor": "陆承渊", "emotion": "neutral", "text": "巷子口传来脚步声。陆承渊走过来，看见你们蹲在树底下，没说话，走过来在旁边蹲下了——" },
                  { "type": "dialog", "speaker": "陆子衡", "emotion": "cheerful", "text": "嘘！你小点声！" },
                  { "type": "action", "actor": "陆承渊", "emotion": "neutral", "text": "陆承渊没搭理他，往树洞里看了一眼，又看了看四周——" },
                  { "type": "dialog", "speaker": "陆承渊", "emotion": "neutral", "text": "我帮你们看着。" },
                  { "type": "effect", "action": "hide", "target": "陆承渊" },
                  { "type": "effect", "action": "hide", "target": "阿雁" }
              ]
          },
          { "type": "effect", "action": "hide", "target": "陆子衡" },
          { "type": "wait", "seconds": 0.5 }
      ]
    },
    {
      "id": "m06_evening_feast",
      "background": "bg_shenjia_hall_evening",
      "bgm": { "track": "bgm_shenjia_warm", "action": "play", "fade": 2 },
      "characters": ["沈伯远", "柳蕙心", "沈婉清", "沈伯宁", "陆子衡", "陆芷薇", "陆承渊", "苏若兰", "苏怀瑾", "柳惠芳", "阿福", "阿雁"],
      "script": [
          { "type": "bg_change", "background": "bg_shenjia_hall_evening", "transition": "fade" },
          { "type": "narration", "text": "天暗下来了。堂屋里点上了灯，橘黄的光照着满桌子的菜。母亲做了好几样你爱吃的——桂花糕、糖醋鱼、一碟子卤味。二叔带来了两包酱菜，搁在桌角。惠芳姨和苏若兰/苏怀瑾也来了，惠芳姨坐在母亲旁边说话。陆子衡一进堂屋就坐到了你旁边，陆芷薇/陆承渊在对面坐了。" },
          { "type": "effect", "action": "show", "target": "沈伯远", "pos": "center", "expr": "neutral" },
          { "type": "narration", "text": "父亲坐在主位上。人齐了，他拿起酒壶，拔了塞子，给你面前的酒盏斟了一杯。酒色清亮，桂花香从壶口飘出来。" },
          { "type": "dialog", "speaker": "主角", "emotion": "neutral", "text": "我能喝了？" },
          { "type": "action", "actor": "沈伯远", "emotion": "neutral", "text": "父亲把酒壶搁下，没让你端——" },
          { "type": "dialog", "speaker": "沈伯远", "emotion": "neutral", "text": "这杯酒先搁着。等你金榜题名那天，再开封。" },
          { "type": "thought", "text": "金榜题名……还早吧？" },
          { "type": "effect", "action": "show", "target": "沈伯宁", "pos": "left", "expr": "cheerful" },
          { "type": "action", "actor": "沈伯宁", "emotion": "cheerful", "text": "二叔在旁边接话，拿筷子敲了敲碗沿——" },
          { "type": "dialog", "speaker": "沈伯宁", "emotion": "cheerful", "text": "沈家的规矩，我当年也是这么过来的。这杯酒啊，我攒了三年才开封——喝的时候差点哭了。" },
          { "type": "dialog", "speaker": "柳蕙心", "emotion": "gentle", "text": "你二叔那杯酒是他自己偷着喝的，没等到中举。" },
          { "type": "action", "actor": "沈伯宁", "emotion": "cheerful", "text": "二叔被戳了老底，嘿嘿笑了两声，夹了块鱼堵嘴。陆子衡在旁边笑得差点把筷子掉了。" },
          { "type": "effect", "action": "hide", "target": "沈伯宁" },
          { "type": "effect", "action": "show", "target": "沈婉清", "pos": "right", "expr": "gentle" },
          { "type": "action", "actor": "沈婉清", "emotion": "gentle", "text": "长姐伸筷子夹了一块鱼肚上的肉，搁到你碗里——" },
          { "type": "dialog", "speaker": "沈婉清", "emotion": "gentle", "text": "这块嫩，多吃点。" },
          { "type": "effect", "action": "hide", "target": "沈婉清" },
          { "type": "wait", "seconds": 0.3 },
          { "type": "effect", "action": "show", "target": "柳蕙心", "pos": "right", "expr": "gentle" },
          { "type": "action", "actor": "柳蕙心", "emotion": "gentle", "text": "母亲把桂花糕的盘子往你面前推了推，没说话，只是笑了笑。" },
          { "type": "effect", "action": "hide", "target": "柳蕙心" },
          { "type": "wait", "seconds": 0.3 },
          { "type": "effect", "action": "show", "target": "沈伯宁", "pos": "left", "expr": "cheerful" },
          { "type": "action", "actor": "沈伯宁", "emotion": "cheerful", "text": "二叔喝了两杯酒，脸红红的，拿筷子点着桌面——" },
          { "type": "dialog", "speaker": "沈伯宁", "emotion": "cheerful", "text": "跟你们说，我当年在茶楼听那个说书的讲《三国》，讲到赵子龙长坂坡——" },
          { "type": "dialog", "speaker": "沈伯宁", "emotion": "cheerful", "text": "那说书的啪一拍桌子，茶碗都震翻了——你们猜怎么着？他自个儿的茶碗，翻的。" },
          { "type": "dialog", "speaker": "沈婉清", "emotion": "cheerful", "text": "二叔，这个故事你上回讲过了。" },
          { "type": "dialog", "speaker": "沈伯宁", "emotion": "cheerful", "text": "讲过了？那我换一个——话说那关云长——" },
          { "type": "action", "actor": "沈婉清", "emotion": "cheerful", "text": "长姐笑着拦住他，给他碗里夹了块鱼——" },
          { "type": "dialog", "speaker": "沈婉清", "emotion": "cheerful", "text": "吃鱼，别说话了。" },
          { "type": "effect", "action": "hide", "target": "沈伯宁" },
          { "type": "wait", "seconds": 0.3 },
          { "type": "effect", "action": "show", "target": "陆子衡", "pos": "left", "expr": "cheerful" },
          { "type": "action", "actor": "陆子衡", "emotion": "cheerful", "text": "陆子衡吃得满嘴油，筷子伸得比谁都快，桂花糕已经下了三块——" },
          {
              "type": "branch",
              "condition": "protagonist_gender",
              "male": [
                  { "type": "effect", "action": "show", "target": "陆芷薇", "pos": "right", "expr": "neutral" },
                  { "type": "action", "actor": "陆芷薇", "emotion": "neutral", "text": "陆芷薇在对面坐着，安安静静的。她看陆子衡碗里没菜了，夹了一筷子过去——" },
                  { "type": "dialog", "speaker": "陆芷薇", "emotion": "neutral", "text": "少吃点糕，吃菜。" },
                  { "type": "dialog", "speaker": "陆子衡", "emotion": "cheerful", "text": "糕好吃！" },
                  { "type": "effect", "action": "hide", "target": "陆芷薇" }
              ],
              "female": [
                  { "type": "effect", "action": "show", "target": "陆承渊", "pos": "right", "expr": "neutral" },
                  { "type": "action", "actor": "陆承渊", "emotion": "neutral", "text": "陆承渊在对面坐着，安安静静的。他看陆子衡碗里没菜了，夹了一筷子过去，没说话。" },
                  { "type": "dialog", "speaker": "陆子衡", "emotion": "cheerful", "text": "哥，你也吃糕啊！" },
                  { "type": "action", "actor": "陆承渊", "emotion": "neutral", "text": "陆承渊摇了摇头，给自己倒了杯茶。" },
                  { "type": "effect", "action": "hide", "target": "陆承渊" }
              ]
          },
          { "type": "effect", "action": "hide", "target": "陆子衡" },
          { "type": "wait", "seconds": 0.3 },
          {
              "type": "branch",
              "condition": "protagonist_gender",
              "male": [
                  { "type": "effect", "action": "show", "target": "苏若兰", "pos": "center", "expr": "neutral" },
                  { "type": "action", "actor": "苏若兰", "emotion": "neutral", "text": "你夹桂花糕的时候抬头，正好对上苏若兰的目光。她坐在惠芳姨旁边，碗里菜没动几筷子——" },
                  { "type": "thought", "text": "她一直在看我？" },
                  { "type": "action", "actor": "苏若兰", "emotion": "neutral", "text": "她很快低下头去了，拿筷子戳了戳碗里的糕，没吃。" },
                  { "type": "effect", "action": "hide", "target": "苏若兰" }
              ],
              "female": [
                  { "type": "effect", "action": "show", "target": "苏怀瑾", "pos": "center", "expr": "neutral" },
                  { "type": "action", "actor": "苏怀瑾", "emotion": "neutral", "text": "你夹桂花糕的时候抬头，正好对上苏怀瑾的目光。他坐在惠芳姨旁边，碗筷放得齐齐整整——" },
                  { "type": "thought", "text": "他一直在看我？" },
                  { "type": "action", "actor": "苏怀瑾", "emotion": "neutral", "text": "他移开眼，端起茶碗喝了一口。茶早就凉了，他喝完了才发觉，眉头皱了一下。" },
