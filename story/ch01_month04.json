{
  "chapter": "第1期·新手教学",
  "month": 4,
  "title": "暗信·家族关系",
  "quest": "quest_m04",
  "scenes": [
    {
      "id": "m04_night_overhear",
      "background": "bg_shenjia_bedroom_night",
      "bgm": { "track": "bgm_shenjia_night", "action": "play", "fade": 3 },
      "characters": ["沈伯远", "柳蕙心"],
      "script": [
          { "type": "narration", "text": "半夜，你被渴醒了。" },
          { "type": "action", "actor": "主角", "emotion": "neutral", "text": "你摸黑爬起来，赤脚踩在地上，凉得缩了一下脚趾。" },
          { "type": "action", "actor": "主角", "emotion": "neutral", "text": "你端起案角的水碗，喝了两口，往外走——灶房的水壶应该还有温的。" },
          { "type": "bg_change", "background": "bg_shenjia_corridor_night", "transition": "fade" },
          { "type": "narration", "text": "廊下没点灯，月光从檐角漏下来，在地上画了一道一道的白。" },
          { "type": "action", "actor": "主角", "emotion": "neutral", "text": "你刚走到书房门口，脚步就停了。门缝里透着光。" },
          { "type": "thought", "text": "这么晚了，父亲还没睡？" },
          { "type": "dialog", "speaker": "沈伯远", "emotion": "worried", "text": "……有些事，不太对。" },
          { "type": "dialog", "speaker": "柳蕙心", "emotion": "worried", "text": "什么事？" },
          { "type": "dialog", "speaker": "沈伯远", "emotion": "worried", "text": "账上的事。我还在查，不便多说。" },
          { "type": "wait", "seconds": 0.5 },
          { "type": "dialog", "speaker": "柳蕙心", "emotion": "worried", "text": "牵了谁？" },
          { "type": "dialog", "speaker": "沈伯远", "emotion": "worried", "text": "不好说。但这条线往上，不是一个人。" },
          { "type": "action", "actor": "主角", "emotion": "neutral", "text": "你蹲在门边，大气不敢出。父亲的声音压得很低，你贴着门缝才听清。" },
          { "type": "wait", "seconds": 1 },
          { "type": "dialog", "speaker": "柳蕙心", "emotion": "gentle", "text": "查你的账，别管别的。家里有我。" },
          { "type": "dialog", "speaker": "沈伯远", "emotion": "worried", "text": "先把副本抄一份。原件锁着，谁也不给。" },
          { "type": "action", "actor": "沈伯远", "emotion": "worried", "text": "父亲没接话。你听见椅子吱呀响了一声，像是他站起来又坐下了。" },
          { "type": "thought", "text": "账上的事……不是一个人……" },
          { "type": "action", "actor": "主角", "emotion": "neutral", "text": "你不敢再听，猫着腰退回了廊柱后面，贴着墙根溜回了自己屋。" },
          { "type": "narration", "text": "屋里黑着。" },
          { "type": "action", "actor": "主角", "emotion": "neutral", "text": "你摸到床边躺下来，眼睛睁着。" },
          { "type": "thought", "text": "父亲在查账。牵的人不是一个人。他要抄副本……是怕原件被人毁掉？" },
          { "type": "thought", "text": "母亲说「家里有我」。她那语气，不像第一次听父亲说这些。" },
          { "type": "wait", "seconds": 0.5 }
      ]
    },
    {
      "id": "m04_lu_visit",
      "background": "bg_shenjia_courtyard_morning",
      "bgm": { "track": "bgm_shenjia_morning", "action": "play", "fade": 2 },
      "characters": ["沈伯远", "柳蕙心", "陆鼎臣"],
      "script": [
          { "type": "bg_change", "background": "bg_shenjia_courtyard_morning", "transition": "fade" },
          { "type": "narration", "text": "次日清早，院门口就传来了马车声。" },
          { "type": "action", "actor": "主角", "emotion": "neutral", "text": "你从屋里探出头，看见一辆马车停在门口。车帘一掀，下来的是陆鼎臣——这回只有他一个人。" },
          { "type": "thought", "text": "上回他带了陆子衡他们来，院里追得鸡飞狗跳的。这回怎么一个人？" },
          { "type": "effect", "action": "show", "target": "陆鼎臣", "pos": "center", "expr": "stern" },
          { "type": "action", "actor": "陆鼎臣", "emotion": "neutral", "text": "陆鼎臣下了车，没像上回那样笑着跟母亲寒暄，只朝父亲拱了拱手。父亲迎上去，两人说了两句，就一块儿往书房走了。" },
          { "type": "dialog", "speaker": "沈伯远", "emotion": "stern", "text": "进去说。" },
          { "type": "action", "actor": "沈伯远", "emotion": "stern", "text": "书房的门关上了。" },
          { "type": "effect", "action": "hide", "target": "陆鼎臣" },
          { "type": "narration", "text": "院里一下子静了。你蹲在廊柱后面，耳朵竖着。" },
          { "type": "dialog", "speaker": "沈伯远", "emotion": "angry", "text": "……这事不能只靠你一个人扛。" },
          { "type": "dialog", "speaker": "陆鼎臣", "emotion": "stern", "text": "你听我说完。那边的人不是小角色，你若现在就上奏——" },
          { "type": "thought", "text": "声音闷在门里，听不完整。但两个人都在急。" },
          { "type": "thought", "text": "上回陆子衡就是在这院子里追着陆芷薇跑的，桂树底下闹了一下午。这回院子里安安静静的，就剩书房里闷着的说话声。" },
          { "type": "thought", "text": "陆子衡这回没来。后巷老槐树树洞里那只雏燕也不知道好些没有。上回看的时候翅膀还没好，阿福喂着呢，也不知道喂得怎么样了。" },
          { "type": "dialog", "speaker": "沈伯远", "emotion": "angry", "text": "那你说怎么办？拖着？" },
          { "type": "dialog", "speaker": "陆鼎臣", "emotion": "stern", "text": "不是拖。是等。等一个拿得住的把柄。" },
          { "type": "wait", "seconds": 0.5 },
          { "type": "effect", "action": "show", "target": "柳蕙心", "pos": "right", "expr": "gentle" },
          { "type": "action", "actor": "柳蕙心", "emotion": "gentle", "vfx": "shake", "text": "一只手搭上你的肩。你差点叫出来——母亲不知道什么时候站在了你身后。" },
          { "type": "dialog", "speaker": "柳蕙心", "emotion": "gentle", "text": "别在这儿听。去私塾。" },
          { "type": "dialog", "speaker": "主角", "emotion": "neutral", "text": "可是——" },
          { "type": "action", "actor": "柳蕙心", "emotion": "gentle", "vfx": "nudge", "text": "她没多说，把你往院门那边推了推。" },
          { "type": "effect", "action": "hide", "target": "柳蕙心" },
          { "type": "wait", "seconds": 1 },
          { "type": "bg_change", "background": "bg_shenjia_courtyard_afternoon", "transition": "fade" },
          { "type": "narration", "text": "下半晌你从私塾回来，马车已经不在了。" },
          { "type": "effect", "action": "show", "target": "陆鼎臣", "pos": "center", "expr": "worried" },
          { "type": "action", "actor": "陆鼎臣", "emotion": "worried", "text": "陆鼎臣正站在院门口，像是要走。他看见你，站住了。" },
          { "type": "action", "actor": "陆鼎臣", "emotion": "worried", "vfx": "nudge", "text": "他走过来，拍了拍你的肩膀。手很重，但拍得不轻不重。" },
          { "type": "dialog", "speaker": "陆鼎臣", "emotion": "worried", "text": "好好念书。" },
          { "type": "dialog", "speaker": "主角", "emotion": "neutral", "text": "陆伯伯……" },
          { "type": "action", "actor": "陆鼎臣", "emotion": "neutral", "text": "他像是还想说什么，嘴张了张，最后挤出一个笑——" },
          { "type": "dialog", "speaker": "陆鼎臣", "emotion": "neutral", "text": "将来比你爹有出息。" },
          { "type": "narration", "text": "他说完就上了车。车帘放下来，你看见他的脸绷着，笑已经收了。" },
          { "type": "effect", "action": "hide", "target": "陆鼎臣" },
          { "type": "effect", "action": "show", "target": "沈伯远", "pos": "center", "expr": "worried" },
          { "type": "action", "actor": "沈伯远", "emotion": "worried", "text": "父亲站在书房门口，看着马车走远。他站了很久，没动。" },
          { "type": "effect", "action": "show", "target": "柳蕙心", "pos": "right", "expr": "gentle" },
          { "type": "action", "actor": "柳蕙心", "emotion": "gentle", "vfx": "nudge", "text": "母亲从廊下走过来，站在他身边。她没说话，伸手轻轻握住了父亲的手。" },
          { "type": "action", "actor": "沈伯远", "emotion": "worried", "text": "父亲低头看了一眼她的手，没松开，也没握紧。两个人就那么站着，直到马车声彻底听不见了。" },
          { "type": "effect", "action": "hide", "target": "沈伯远" },
          { "type": "effect", "action": "hide", "target": "柳蕙心" },
          { "type": "tutorial", "system": "家族关系", "text": "沈陆两家是世交，如今这份交情有了数值。点击「家族」界面，查看与陆家的关系值。关系值会随时间衰减，需要定期维护——走亲、互助、联姻都能维护或提升关系。" },
          { "type": "pause", "reason": "view_relation", "detail": "查看与陆家的关系值", "objective": "obj_m04_01" },
          { "type": "wait", "seconds": 0.5 }
      ]
    },
    {
      "id": "m04_uncle_borrow",
      "background": "bg_shenjia_courtyard_evening",
      "bgm": null,
      "characters": ["沈伯远", "沈伯宁"],
      "script": [
          { "type": "bg_change", "background": "bg_shenjia_courtyard_evening", "transition": "fade" },
          { "type": "narration", "text": "傍晚，日头矮了。你在院里蹲着逗蚂蚁，院门响了一下。" },
          { "type": "effect", "action": "show", "target": "沈伯宁", "pos": "left", "expr": "neutral" },
          { "type": "action", "actor": "沈伯宁", "emotion": "neutral", "text": "二叔从侧门进来。这回他没像往常那样大嗓门喊你，脚步也慢了些。他看见你蹲在地上，嘴角动了一下，算是笑了笑。" },
          { "type": "dialog", "speaker": "沈伯宁", "emotion": "neutral", "text": "你爹在书房么？" },
          { "type": "dialog", "speaker": "主角", "emotion": "neutral", "text": "在。" },
          { "type": "action", "actor": "沈伯宁", "emotion": "neutral", "text": "他点了点头，往书房那边走。走了两步又回头看了一眼你，像是要说什么，但没说。" },
          { "type": "action", "actor": "沈伯宁", "emotion": "neutral", "text": "他走到书房门前，站了一会儿。你看见他的手抬起来要敲门，在半空停了一下，才敲了三下。" },
          { "type": "dialog", "speaker": "沈伯远", "emotion": "neutral", "text": "谁？" },
          { "type": "dialog", "speaker": "沈伯宁", "emotion": "neutral", "text": "哥，是我。" },
          { "type": "effect", "action": "hide", "target": "沈伯宁" },
          { "type": "narration", "text": "门开了，又关上了。你在院里蹲着，耳朵竖着。" },
          { "type": "dialog", "speaker": "沈伯远", "emotion": "stern", "text": "什么事？" },
          { "type": "dialog", "speaker": "沈伯宁", "emotion": "worried", "text": "哥，我……手头有点紧。" },
          { "type": "dialog", "speaker": "沈伯远", "emotion": "stern", "text": "多少？" },
          { "type": "dialog", "speaker": "沈伯宁", "emotion": "worried", "text": "几十贯。" },
          { "type": "wait", "seconds": 0.5 },
          { "type": "dialog", "speaker": "沈伯远", "emotion": "angry", "text": "几十贯？你又做什么了？" },
          { "type": "action", "actor": "沈伯宁", "emotion": "worried", "text": "二叔的声音低下去，你听不清了。隔了几句，父亲的声音又冒出来——" },
          { "type": "dialog", "speaker": "沈伯远", "emotion": "angry", "text": "……你一个月在茶楼挣多少？几十贯从哪儿欠的？" },
          { "type": "action", "actor": "沈伯宁", "emotion": "worried", "text": "二叔又说了几句，声音更低了。" },
          { "type": "wait", "seconds": 1 },
          { "type": "narration", "text": "过了好一会儿，书房里安静了。然后是一声叹气，很长，很重。" },
          { "type": "thought", "text": "父亲叹气了。" },
          { "type": "effect", "action": "show", "target": "沈伯宁", "pos": "left", "expr": "worried" },
          { "type": "action", "actor": "沈伯宁", "emotion": "worried", "text": "书房门开了。二叔出来，脸上讪讪的。他看见你蹲在院子里，愣了一下，挤了个笑——" },
          { "type": "dialog", "speaker": "沈伯宁", "emotion": "neutral", "text": "跟你爹说了点家务事。" },
          { "type": "dialog", "speaker": "主角", "emotion": "neutral", "text": "二叔，你没事吧？" },
          { "type": "action", "actor": "沈伯宁", "emotion": "cheerful", "vfx": "nudge", "text": "他揉了一把你的脑袋，比平时用力了一点——" },
          { "type": "dialog", "speaker": "沈伯宁", "emotion": "cheerful", "text": "没事。大人的事，你管什么。" },
          { "type": "action", "actor": "沈伯宁", "emotion": "neutral", "text": "他转身往院门走。走了两步，脚步又慢了。他没回头，但肩膀塌了一点。" },
          { "type": "effect", "action": "hide", "target": "沈伯宁" },
          { "type": "thought", "text": "二叔说没事。可父亲叹气了。" },
          { "type": "thought", "text": "几十贯……他不说从哪儿欠的。" },
          { "type": "thought", "text": "父亲也没问出来。" },
          { "type": "wait", "seconds": 0.5 }
      ]
    },
    {
      "id": "m04_next_morning",
      "background": "bg_shenjia_courtyard_morning",
      "bgm": { "track": "bgm_shenjia_morning", "action": "play", "fade": 2 },
      "characters": ["沈伯远", "柳蕙心", "阿福", "阿雁"],
      "script": [
          { "type": "bg_change", "background": "bg_shenjia_courtyard_morning", "transition": "fade" },
          { "type": "narration", "text": "第二天一早，饭桌摆好了。粥、咸菜、一碟酱瓜。" },
          {
              "type": "branch",
              "condition": "protagonist_gender",
              "male": [
                  { "type": "effect", "action": "show", "target": "阿福", "pos": "left", "expr": "neutral" },
                  { "type": "action", "actor": "阿福", "emotion": "shy", "text": "阿福把碗筷摆好，缩到你旁边的凳子上坐着，眼巴巴等开饭。" }
              ],
              "female": [
                  { "type": "effect", "action": "show", "target": "阿雁", "pos": "left", "expr": "neutral" },
                  { "type": "action", "actor": "阿雁", "emotion": "shy", "text": "阿雁把碗筷摆好，站在你旁边，手在围裙上擦了擦。" }
              ]
          },
          { "type": "effect", "action": "show", "target": "沈伯远", "pos": "center", "expr": "stern" },
          { "type": "action", "actor": "沈伯远", "emotion": "neutral", "text": "父亲坐下来，端起粥碗，又搁下了。他看了你一眼——" },
          { "type": "dialog", "speaker": "沈伯远", "emotion": "stern", "text": "昨日那段，背来。" },
          { "type": "thought", "text": "又考背书……昨天光顾着走神了。" },
          { "type": "dialog", "speaker": "主角", "emotion": "neutral", "text": "「天之生此民也，使先知觉后知，使先觉觉后觉……」" },
          { "type": "action", "actor": "主角", "emotion": "neutral", "text": "你背了三句，卡了一下，又接上了。" },
          { "type": "dialog", "speaker": "沈伯远", "emotion": "stern", "text": "「予天民之先觉者也」后面是什么？" },
          { "type": "dialog", "speaker": "主角", "emotion": "neutral", "text": "「予将以斯道觉斯民也。」" },
          { "type": "action", "actor": "沈伯远", "emotion": "neutral", "text": "父亲点了点头，端起粥碗喝了。像是跟平时没什么两样。" },
          { "type": "effect", "action": "show", "target": "柳蕙心", "pos": "right", "expr": "gentle" },
          { "type": "action", "actor": "柳蕙心", "emotion": "gentle", "vfx": "nudge", "text": "母亲给你夹了一筷咸菜，顺手把酱瓜碟子往父亲那边推了推。" },
          { "type": "action", "actor": "主角", "emotion": "neutral", "text": "你低头喝粥，眼角瞥见父亲的手——他握着碗沿的手指上，有一道墨痕，从指腹一直蹭到了虎口。不是刚沾上的，像是洗了没洗干净。" },
          { "type": "thought", "text": "那道墨痕……洗了都没洗干净。" },
          { "type": "thought", "text": "父亲手上那道墨……什么时候沾的？" },
          {
              "type": "branch",
              "condition": "protagonist_gender",
              "male": [
                  { "type": "action", "actor": "阿福", "emotion": "shy", "vfx": "shake", "text": "阿福也看见了，嘴张了张想说什么，你踩了他一脚，他缩回去了。" }
              ],
              "female": [
                  { "type": "action", "actor": "阿雁", "emotion": "shy", "text": "阿雁也看见了，眼睛在父亲手上停了一下，又低下头扒饭，什么也没说。" }
              ]
          },
          { "type": "dialog", "speaker": "沈伯远", "emotion": "stern", "text": "吃完去私塾。下午回来把今天念的抄一遍。" },
          { "type": "dialog", "speaker": "主角", "emotion": "neutral", "text": "知道了。" },
          { "type": "effect", "action": "hide", "target": "沈伯远" },
          { "type": "effect", "action": "hide", "target": "柳蕙心" },
          { "type": "narration", "text": "父亲起身回了书房。你听见椅子吱呀一声，他坐下了，接着是翻纸的声音——一页，又翻一页。" },
          { "type": "thought", "text": "昨晚的账目，陆伯伯说的那些话，二叔的几十贯……父亲一个人在书房里扛着。" },
          {
              "type": "branch",
              "condition": "protagonist_gender",
              "male": [
                  { "type": "effect", "action": "hide", "target": "阿福" }
              ],
              "female": [
                  { "type": "effect", "action": "hide", "target": "阿雁" }
              ]
          },
          { "type": "wait", "seconds": 1 },
          { "type": "tutorial", "system": "声望与事件", "text": "家族声望会随时间自然衰减，需通过事件和互动维护。点击「下一回合」结算本月后，可能随机触发家族事件（如邻家送来时令礼帖、族人考绩通报等），事件会弹出供你选择，不同选择有不同后果。" },
          { "type": "pause", "reason": "advance_turn", "detail": "结算本月并进入下一回合", "objective": "obj_m04_02" }
      ]
    }
  ]
}
